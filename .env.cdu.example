# Copy to .env.cdu and fill in the secrets.
# Used by: docker compose --env-file .env.cdu -f docker-compose.cdu.yml up -d --build
#
# KAKO OVO DOLAZI DO APLIKACIJE
#   docker-compose.cdu.yml ima `env_file: - .env.cdu`, pa SVE iz ove datoteke ulazi u
#   kontejner kao environment varijabla. Novi ključ ne treba nigdje drugdje dodavati.
#   Iznimka: `environment:` blok u compose datoteci ima prednost i drži ono što je na
#   CDU fiksno (profil, CORS, URL-ovi frontenda, eGOP prekidači).
#
#   PRAZNA VRIJEDNOST NIJE ISTO ŠTO I NEPOSTAVLJENA. `KLJUC=` šalje praznu ali
#   postavljenu varijablu, a Spring default iz ${KLJUC:default} vrijedi samo kad
#   varijabla NE POSTOJI — prazna ga pregazi. Ključ koji ne postavljaš zakomentiraj,
#   nemoj ga ostaviti prazan, osim ako je i default prazan (npr. STR_TIJELO_OIB).
#
#   Datoteka MORA postojati: bez nje `docker compose up` puca na env_file.

# CDU Postgres — confirmed credentials for db `eturizam` on 172.20.8.196:5432
CDU_DB_URL=jdbc:postgresql://172.20.8.196:5432/eturizam
CDU_DB_USERNAME=shorttermrental
CDU_DB_PASSWORD=

# Draft encryption key (AES-256, 32 random bytes base64-encoded).
# Generate once and keep stable; rotating invalidates existing encrypted drafts.
#   openssl rand -base64 32
DRAFT_ENC_KEY=

# eGOP — uredsko poslovanje MINT-a (SOAP/NTLM).
# NA CDU OSTAJE UGAŠEN: eGOP test instanca je na internoj InfoDom mreži
# (http://egop2builder/EAI_MINT) i s ove kutije nije dohvatljiva. Živi testovi idu na
# InfoDom dev okolini (s-str-02) — vidi .env.dev.example.
# Kredencijale je dao InfoDom 26.07.2026; to je NJIHOV dijeljeni test račun, ne naš —
# tražiti namjenski STR servisni račun prije ozbiljnijeg korištenja.
# Ako se ikad pali odavde: EGOP_BASE_URL je OBAVEZAN (nema ugrađenog defaulta, da se ne
# puca na tuđi eGOP), a dohvatljivost se prvo provjeri:
#   curl -sk -o /dev/null -w '%{http_code}\n' "$EGOP_BASE_URL/ServiceMDM.asmx?wsdl"
#   (očekuj 401 ili 200; vješanje = firewall)
# Prazno ili false => radi EgopClientMock, ništa ne odlazi prema MINT-u.
EGOP_ENABLED=false
#EGOP_BASE_URL=
EGOP_USERNAME=
EGOP_PASSWORD=
# Aplikacijski identitet u SOAP payloadu; defaulti su INFODOM\strservis pa se
# obično ne moraju postavljati.
EGOP_APP_DOMAIN=INFODOM
EGOP_APP_USERNAME=strservis
# Rješavatelj predmeta — mora biti osoba s username-om. Prazno => app-domain\app-username.
# Ako OdrediRjesavatelja padne u logu, ovdje se probaju druge vrijednosti bez rebuilda.
EGOP_RJESAVATELJ=
# Timeouti prema eGOP-u. Defaulti 5 s / 15 s; dizati samo ako se pokaže da državna
# mreža traži više — urudžbiranje ide sinkrono na request threadu.
#EGOP_CONNECT_TIMEOUT_MS=5000
#EGOP_READ_TIMEOUT_MS=15000
# false: prolazni ispad eGOP-a ne smije oboriti servis (na ovoj kutiji vrti i NIAS test).
EGOP_CODEBOOKS_FAIL_FAST=false
# DEBUG ispisuje svaki SOAP poziv s trajanjem. Za PRVI živi run staviti DEBUG — inače se
# iz loga vidi samo je li cijeli tok prošao, ne i koji je poziv visio ili pao.
EGOP_LOG_LEVEL=INFO
# true => pun SOAP zahtjev/odgovor (envelope) u logu. Za dubinsku dijagnostiku prvog testa;
# ispisuje osobne podatke i base64 PDF, pa GASITI poslije. EGOP_LOG_LEVEL nije bitan
# (MessageTracing ide na TRACE neovisno).
EGOP_TRACE_SOAP=false
# Vrste pismena bez potvrđene šifre u eGOP šifrarniku — takav se akt zapisuje i vidi se u
# popisu dokumenata RB-a, ali se ne šalje eGOP-u (inače vrti retry do iscrpljenja); mail
# svejedno ide. Slug se miče s popisa čim InfoDom potvrdi šifru. Prazno = sve se urudžbira.
EGOP_AKTI_BEZ_SIFRE=reaktivacija,prijedlog-suspenzije,obustava-suspenzije
# Defaulti u aplikaciji su test okruženje (egopeaitest.mint.hr). ODKOMENTIRATI samo za prod.
# Ne ostavljati prazne — prazna vrijednost je postavljena vrijednost i pregazila bi default.
#EGOP_MDM_URL=https://egopeai.mint.hr/ServiceMDM.asmx
#EGOP_PISMENO_URL=https://egopeai.mint.hr/ServicePismeno.asmx
#EGOP_PREDMET_URL=https://egopeai.mint.hr/ServicePredmet.asmx
#EGOP_SUBJEKT_URL=https://egopeai.mint.hr/ServiceSubjekt.asmx

# Identitet tijela na aktima — čl. 98. st. 2 ZUP-a traži naziv i OIB tijela, propis o
# nadležnosti i potpisnika. Dok su prazni, svaki akt vidljivo ispisuje
# "[nije konfigurirano: str.documents.tijelo.oib]" i logira ERROR.
# OIB NIJE potvrđen: HR87892589782 iz NIAS certifikata pripada posuđenom certifikatu
# (InterniTurizam), pa ga treba provjeriti prije nego akti odu strankama.
STR_TIJELO_NAZIV=MINISTARSTVO TURIZMA I SPORTA
STR_TIJELO_OIB=
STR_TIJELO_ADRESA=Prisavlje 14
STR_TIJELO_MJESTO=Zagreb
STR_TIJELO_USTROJ=Uprava za turizam
# Točan propis koji tijelu daje nadležnost za registracijski broj — potvrditi s pravnom službom.
STR_TIJELO_PROPIS=
STR_POTPISNIK_IME=
STR_POTPISNIK_FUNKCIJA=Voditelj postupka
# Paliti tek kad postoji kvalificirani elektronički pečat; do tada akt ne smije tvrditi ovjeru.
STR_EPECAT_ENABLED=false
# true => predlošci akata se čitaju s diska pri svakom renderu (korisno dok pravna
# služba dorađuje tekst — izmjena .txt datoteke djeluje bez restarta).
STR_DOCUMENTS_RELOAD=false

# Obavijesti e-poštom. Ugašene dok se ne potvrdi SMTP dohvatljiv s ove kutije;
# s false radi LoggingEmailService i poruke se samo zapisuju u log.
APP_MAIL_ENABLED=false
APP_MAIL_FROM=noreply@str-test-eturizam.gov.hr
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=25

# NIAS SAML2 keystore (nias-sp.jks).
# Upload the JKS to CDU_SECRETS_DIR (default /home/vviskov/str-secrets/nias-sp.jks)
# and set the password below.
CDU_SECRETS_DIR=/home/vviskov/str-secrets
NIAS_KEYSTORE_PASSWORD=

# NIAS-registered URLs — MUST match exactly what the NIAS team registered for SP `niasaptst`.
# If they registered the port-bearing form (https://...:8085), uncomment the :8085 variants below.
NIAS_ACS_URL=https://str-test-eturizam.gov.hr/login/saml2/sso/nias
NIAS_SLO_URL=https://str-test-eturizam.gov.hr/logout/saml2/slo/nias
NIAS_SUCCESS_REDIRECT_URL=https://str-test-eturizam.gov.hr/existing-objects
# NIAS_ACS_URL=https://str-test-eturizam.gov.hr:8085/login/saml2/sso/nias
# NIAS_SLO_URL=https://str-test-eturizam.gov.hr:8085/logout/saml2/slo/nias
# NIAS_SUCCESS_REDIRECT_URL=https://str-test-eturizam.gov.hr:8085/existing-objects

# Ostali NIAS ključevi rade na defaultima iz application-cdu.properties.
# entity-id i key-alias mijenjaju se kad STR dobije VLASTITI FINA certifikat —
# trenutni je posuđen od InterniTurizam, zbog čega logout još ne radi.
#NIAS_ENTITY_ID=
#NIAS_KEY_ALIAS=
#NIAS_METADATA_URI=
#NIAS_FAILURE_REDIRECT_URL=
#NIAS_LOGOUT_REDIRECT_URL=
