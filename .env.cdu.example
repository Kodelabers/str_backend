# Copy to .env.cdu and fill in the secrets.
# Used by: docker compose --env-file .env.cdu -f docker-compose.cdu.yml up -d --build
#
# KAKO OVO DOLAZI DO APLIKACIJE
#   docker-compose.cdu.yml ima `env_file: - .env.cdu`, pa SVE iz ove datoteke ulazi u
#   kontejner kao environment varijabla. Novi ključ ne treba nigdje drugdje dodavati.
#   Iznimka: `environment:` blok u compose datoteci ima prednost i drži ono što je na
#   CDU fiksno (profil, CORS, URL-ovi frontenda, eGOP prekidači).
#
#   PRAZNA VRIJEDNOST NIJE ISTO ŠTO I NEPOSTAVLJENA. `KLJUC=` šalje praznu ali
#   postavljenu varijablu, a Spring default iz ${KLJUC:default} vrijedi samo kad
#   varijabla NE POSTOJI — prazna ga pregazi. Ključ koji ne postavljaš zakomentiraj,
#   nemoj ga ostaviti prazan, osim ako je i default prazan (npr. STR_POTPISNIK_IME).
#
#   Datoteka MORA postojati: bez nje `docker compose up` puca na env_file.

# CDU Postgres — confirmed credentials for db `eturizam` on 172.20.8.196:5432
CDU_DB_URL=jdbc:postgresql://172.20.8.196:5432/eturizam
CDU_DB_USERNAME=shorttermrental
CDU_DB_PASSWORD=

# Draft encryption key (AES-256, 32 random bytes base64-encoded).
# Generate once and keep stable; rotating invalidates existing encrypted drafts.
#   openssl rand -base64 32
DRAFT_ENC_KEY=

# eGOP — uredsko poslovanje MINT-a (SOAP/NTLM).
# NA CDU OSTAJE UGAŠEN: eGOP test instanca je na internoj InfoDom mreži
# (http://egop2builder/EAI_MINT) i s ove kutije nije dohvatljiva. Živi testovi idu na
# InfoDom dev okolini (s-str-02) — vidi .env.dev.example.
# Kredencijale je dao InfoDom 26.07.2026; to je NJIHOV dijeljeni test račun, ne naš —
# tražiti namjenski STR servisni račun prije ozbiljnijeg korištenja.
# Ako se ikad pali odavde: EGOP_BASE_URL je OBAVEZAN (nema ugrađenog defaulta, da se ne
# puca na tuđi eGOP), a dohvatljivost se prvo provjeri:
#   curl -sk -o /dev/null -w '%{http_code}\n' "$EGOP_BASE_URL/ServiceMDM.asmx?wsdl"
#   (očekuj 401 ili 200; vješanje = firewall)
# Prazno ili false => radi EgopClientMock, ništa ne odlazi prema MINT-u.
EGOP_ENABLED=false
#EGOP_BASE_URL=
EGOP_USERNAME=
EGOP_PASSWORD=
# Aplikacijski identitet u SOAP payloadu; defaulti su INFODOM\strservis pa se
# obično ne moraju postavljati.
EGOP_APP_DOMAIN=INFODOM
EGOP_APP_USERNAME=strservis
# Rješavatelj predmeta — mora biti osoba s username-om. Prazno => app-domain\app-username.
# Ako OdrediRjesavatelja padne u logu, ovdje se probaju druge vrijednosti bez rebuilda.
EGOP_RJESAVATELJ=
# Timeouti prema eGOP-u. Defaulti 5 s / 15 s; dizati samo ako se pokaže da državna
# mreža traži više — urudžbiranje ide sinkrono na request threadu.
#EGOP_CONNECT_TIMEOUT_MS=5000
#EGOP_READ_TIMEOUT_MS=15000
# false: prolazni ispad eGOP-a ne smije oboriti servis (na ovoj kutiji vrti i NIAS test).
EGOP_CODEBOOKS_FAIL_FAST=false
# DEBUG ispisuje svaki SOAP poziv s trajanjem. Za PRVI živi run staviti DEBUG — inače se
# iz loga vidi samo je li cijeli tok prošao, ne i koji je poziv visio ili pao.
EGOP_LOG_LEVEL=INFO
# true => pun SOAP zahtjev/odgovor (envelope) u logu. Za dubinsku dijagnostiku prvog testa;
# ispisuje osobne podatke i base64 PDF, pa GASITI poslije. EGOP_LOG_LEVEL nije bitan
# (MessageTracing ide na TRACE neovisno).
EGOP_TRACE_SOAP=false
# Vrste pismena bez potvrđene šifre u eGOP šifrarniku — takav se akt zapisuje i vidi se u
# popisu dokumenata RB-a, ali se ne šalje eGOP-u (inače vrti retry do iscrpljenja); mail
# svejedno ide. Slug se miče s popisa čim InfoDom potvrdi šifru. Prazno = sve se urudžbira.
# Od 22.10.2026. prazno: MINT je unio sve vrste pismena (i reaktivaciju, prijedlog, obustavu).
# T12 (studeni 2026.) donosi tri nove izlazne vrste koje MINT još nije unio: „Obavijest o prijedlogu
# povlačenja…", „Obavijest o obustavi postupka povlačenja…" i „Obavijest o reaktivaciji povučenog…".
# Uz EGOP_ENABLED=true i bez EGOP_SIFRA_PISMENA_FALLBACK do unosa postaviti:
#   EGOP_AKTI_BEZ_SIFRE=prijedlog-povlacenja,obustava-povlacenja,reaktivacija-povlacenja
# (ili zamjensku šifru EGOP_SIFRA_PISMENA_FALLBACK). Uz eGOP mock nije potrebno.
EGOP_AKTI_BEZ_SIFRE=
# Pod čijim korisnikom idu akti nakon dodjele: SLUZBENIK (default, urbroj službenika) ili
# APLIKACIJSKI (svi pod EGOP_APP_USERNAME). APLIKACIJSKI samo dok službenik ne smije otvoriti
# predmet 334-06/11 s nadležnom jedinicom (EGOP_NAZIV_USTROJ).
#EGOP_AKTI_KORISNIK=APLIKACIJSKI
# Otprema izlaznih pismena u korisnički pretinac (KP) preko eGOP-a. Paliti tek kad InfoDom
# odgovori na pitanja iz docs/eGOP-endpoint-analiza.md §KP otprema (konfiguracija slanja, prava).
EGOP_KP_ENABLED=false
# Vrsta priloga uz pismena (T17, KreirajPrilogIPridruziDokument): šifra iz MDM šifrarnika vrsta
# priloga (DohvatiVrstePrilogaActive) ili naziv koji se u njemu razrješava (default „Prilog").
# Uz EGOP_ENABLED=true provjerava se pri startu: startup_egop_prilog_unresolved u logu znači da akti
# idu u eGOP/KP BEZ priloga, a prilozi se iscrpe u retryju (egop_prilog_retry_exhausted). Naziv ne
# ostavljati praznim — prazna vrijednost pregazi default. Otvoreno pitanje za InfoDom: najveći SOAP
# zahtjev koji eGOP prima — prilog od 10 MB je ~13,4 MB base64 u jednom KreirajPrilogIPridruziDokument.
#EGOP_SIFRA_PRILOGA=
#EGOP_NAZIV_PRILOGA=Prilog
# Defaulti u aplikaciji su test okruženje (egopeaitest.mint.hr). ODKOMENTIRATI samo za prod.
# Ne ostavljati prazne — prazna vrijednost je postavljena vrijednost i pregazila bi default.
#EGOP_MDM_URL=https://egopeai.mint.hr/ServiceMDM.asmx
#EGOP_PISMENO_URL=https://egopeai.mint.hr/ServicePismeno.asmx
#EGOP_PREDMET_URL=https://egopeai.mint.hr/ServicePredmet.asmx
#EGOP_SUBJEKT_URL=https://egopeai.mint.hr/ServiceSubjekt.asmx

# Identitet tijela na aktima — čl. 98. st. 2 ZUP-a traži naziv i OIB tijela, propis o
# nadležnosti i potpisnika. Nekonfigurirano polje akt vidljivo ispisuje kao
# "[nije konfigurirano: str.documents.tijelo.oib]" i logira ERROR.
# Naziv otvara rečenicu uvoda akta, pa ide velikim POČETNIM slovom i ostatkom malim:
# Ministarstvo turizma i sporta. NE cijeli velikim slovima — zaglavlje i potpis ga sami
# pišu velikim. Mali početak znači da akt počinje malim slovom; StartupDiagnostics
# to prijavi WARN-om startup_documents_naziv_pocinje_malim_slovom.
STR_TIJELO_NAZIV=Ministarstvo turizma i sporta
# OIB i propis o nadležnosti imaju default u application.properties, iz predloška akta koji je
# MINT poslao 11.09.2026. NE postavljati ih ovdje praznima — prazna vrijednost pregazi default.
# STR_TIJELO_OIB=87892589782
STR_TIJELO_ADRESA=Prisavlje 14
STR_TIJELO_MJESTO=Zagreb
STR_TIJELO_USTROJ=Uprava za turizam
# Propis o nadležnosti: default je tekst iz predloška MINT-a; brojevi Narodnih novina još nedostaju.
# STR_TIJELO_PROPIS=
# Propis po vrsti akta (T14): dodjela čl. 46. st. 3., ostali akti čl. 48. st. 2. — default u
# application.properties; postaviti tek kad stignu brojevi Narodnih novina.
# STR_PROPIS_DODJELA=
# STR_PROPIS_POSTUPCI=
STR_POTPISNIK_IME=
# Funkcija se u ugradenom potpisu NE ispisuje (potpis je naziv tijela) — ostaje samo za
# predlozak koji je izrijekom koristi.
# STR_POTPISNIK_FUNKCIJA=Voditelj postupka
# Paliti tek kad postoji kvalificirani elektronički pečat; do tada akt ne smije tvrditi ovjeru.
STR_EPECAT_ENABLED=false
# Kvalificirani e-pečat izlaznih akata (STR eSeal API, docs/ESEAL-SPREMNOST.md). Uz true se
# obavijest o dodjeli i akti životnog ciklusa pečatiraju prije prilaganja u eGOP; ako pečat ne
# uspije, akt se NE prilaže i NE ide u KP (greška u logu: eseal_seal / eseal_pismeno_failed, i u
# str_rn.egop_pismeno.sync_error). Uz true su URL, ključ i projekt obvezni — inače servis ne krene.
# Prije paljenja provjeriti dohvatljivost (očekivano 400 IDEMPOTENCY_KEY_MISSING):
#   curl -s -X POST "$ESEAL_BASE_URL/api/v1/seals/pdf" -H "X-API-Key: $ESEAL_API_KEY"
ESEAL_ENABLED=false
ESEAL_BASE_URL=
ESEAL_API_KEY=
ESEAL_PROJECT=
# Specifikacija traži >= 90 s; ne ostavljati prazno ako se odkomentira.
#ESEAL_READ_TIMEOUT_MS=90000
# true samo kad je servis na internoj mreži dostupan isključivo preko http:// (CDU test). Ključ i
# akti tada idu bez TLS-a; nikad za produkciju.
#ESEAL_ALLOW_HTTP=true
# true => akti tijela izlaze kao PDF/A-1b. eSeal može odbiti PDF koji nije PDF/A (PDF_NOT_PDFA).
STR_DOCUMENTS_PDFA=false
# true => predlošci akata se čitaju s diska pri svakom renderu (korisno dok pravna
# služba dorađuje tekst — izmjena .txt datoteke djeluje bez restarta).
STR_DOCUMENTS_RELOAD=false

# Obavijesti e-poštom preko CDU relaya servmail.ssc.gov.hr:25 (default u
# application-cdu.properties, kao i pošiljatelj testeduturizam@mints.hr). S false radi
# LoggingEmailService i poruke se samo zapisuju u log.
APP_MAIL_ENABLED=false
# U bazi su adrese iznajmljivača iz eTurizma, a relay prosljeđuje bilo kamo. Uz
# APP_MAIL_ENABLED=true OBAVEZNO postaviti: sve poruke idu na ovu adresu, stvarni primatelj
# je u predmetu ("[za: ...] "). Prazno = poruke idu stvarnim primateljima.
# APP_MAIL_REDIRECT_TO=ime.prezime@kodelab.hr
# Najveća (kodirana) poruka koju relay prima; prilozi akta koji s aktom ne stanu u nju samo se
# navode u poruci. Relay koji poruku ipak odbije zbog veličine (552) dobiva odmah varijantu s popisom.
#APP_MAIL_MAX_MESSAGE_SIZE=20MB
# Adresa korisničkog pretinca za poveznicu u porukama iznajmljivaču s pretincem (apsolutni http(s) URL).
# Nepostavljeno = poruka ide bez poveznice. Točna adresa još nije potvrđena.
#APP_MAIL_KP_URL=

# NIAS SAML2 keystore (nias-sp.jks).
# Upload the JKS to CDU_SECRETS_DIR (default /home/vviskov/str-secrets/nias-sp.jks)
# and set the password below.
CDU_SECRETS_DIR=/home/vviskov/str-secrets
NIAS_KEYSTORE_PASSWORD=

# NIAS-registered URLs — MUST match exactly what the NIAS team registered for SP `niasaptst`.
# If they registered the port-bearing form (https://...:8085), uncomment the :8085 variants below.
NIAS_ACS_URL=https://str-test-eturizam.gov.hr/login/saml2/sso/nias
NIAS_SLO_URL=https://str-test-eturizam.gov.hr/logout/saml2/slo/nias
# Povratak nakon prijave: frontend ruta /new-registration-number, koja korisnika vraća na
# odredište spremljeno prije prijave (npr. tuStart ?facilityId=). Ne mijenjati bez frontenda.
NIAS_SUCCESS_REDIRECT_URL=https://str-test-eturizam.gov.hr/new-registration-number
# NIAS_ACS_URL=https://str-test-eturizam.gov.hr:8085/login/saml2/sso/nias
# NIAS_SLO_URL=https://str-test-eturizam.gov.hr:8085/logout/saml2/slo/nias
# NIAS_SUCCESS_REDIRECT_URL=https://str-test-eturizam.gov.hr:8085/new-registration-number

# Ostali NIAS ključevi rade na defaultima iz application-cdu.properties.
# entity-id i key-alias mijenjaju se kad STR dobije VLASTITI FINA certifikat —
# trenutni je posuđen od InterniTurizam, zbog čega logout još ne radi.
#NIAS_ENTITY_ID=
#NIAS_KEY_ALIAS=
#NIAS_METADATA_URI=
#NIAS_FAILURE_REDIRECT_URL=
#NIAS_LOGOUT_REDIRECT_URL=

# --- Zajednička sesija i OIB sustav (DEPLOY-CDU.md §8c) ---------------------------------------
# Defaulti su u application-<profil>.properties: sesije u session.spring_session (tablica
# str-internal-api), OIB sustav uključen za FO i PO. Povratak bez rebuilda:
#SPRING_SESSION_TABLE=str_rn.spring_session
#APP_OIB_REGISTRY_ENABLED=false
#APP_OIB_REGISTRY_LEGAL_ENTITY_ENABLED=false
#APP_OIB_REGISTRY_BASE_URL=

# --- Žurna verifikacija (T8, DEPLOY-CDU.md) ----------------------------------------------------
# RB izdan za neverificiran eTurizam objekt → str.verification_request (+ obavijesti službenicima).
# Korisnik shorttermrental na CDU testu ima INSERT/UPDATE na obje tablice (V11, 5. 11. 2026.), pa
# se ovdje smije uključiti. Provjera: startup_eturizam_verifikacija … nedostaje=[] u logu.
STR_ETURIZAM_VERIFIKACIJA_ENABLED=false
#STR_ETURIZAM_VERIFIKACIJA_KORISNIK=STR
# Najdulje trajanje pokušaja (i čekanja na zaključan redak): retry job / prvi pokušaj na niti HTTP
# zahtjeva. Istek je običan neuspjeh. Zadane vrijednosti su u EturizamVerifikacijaProperties.
#STR_ETURIZAM_VERIFIKACIJA_TIMEOUT=PT10S
#STR_ETURIZAM_VERIFIKACIJA_INLINE_TIMEOUT=PT3S
# Obavijesti službenicima nadležne jedinice (str.korisnicka_obavijest). Vrsta, objekt_tip i tekst
# eTurizam još nije potvrdio — paliti tek nakon potvrde. Tekst: {rn} = RB, {objekt} = naziv/mjesto/ID.
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_ENABLED=false
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_VRSTA=VERIFIKACIJA_ZATRAZENA
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_OBJEKT_TIP=VERIFIKACIJA_RJESENJA
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_TEKST=
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_TEKST_NOVI_OBJEKT=
# Najviše obavijesti po zahtjevu (aktivnih internih korisnika jedinice); iznad toga WARN i prvih toliko.
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_MAX_PRIMATELJA=200
# Retry (EturizamVerifikacijaRetryJob): backoff 5 min … 2 h, nakon max-attempts ABANDONED + ERROR.
# Bez prava (permission denied) pokušaji se ne troše; redak čeka PENDING.
#STR_ETURIZAM_VERIFIKACIJA_RETRY_CRON=0 */5 * * * *
#STR_ETURIZAM_VERIFIKACIJA_RETRY_MAX_ATTEMPTS=10
#STR_ETURIZAM_VERIFIKACIJA_RETRY_BACKOFF_BASE=PT5M
#STR_ETURIZAM_VERIFIKACIJA_RETRY_BACKOFF_MAX=PT2H
