# Draft encryption key (AES-256, base64-encoded 32 bytes). Generate with:
#     openssl rand -base64 32
DRAFT_ENC_KEY=CHANGE_ME_base64_32_bytes

# eGOP (uz EGOP_ENABLED=true; lokalno radi mock).
# Vrste pismena postupka povlačenja (T12: prijedlog-povlacenja, obustava-povlacenja,
# reaktivacija-povlacenja) dok ih MINT ne unese u eGOP: zamjenska šifra ili popis bez šifre.
#EGOP_SIFRA_PISMENA_FALLBACK=
#EGOP_AKTI_BEZ_SIFRE=prijedlog-povlacenja,obustava-povlacenja,reaktivacija-povlacenja
# Očitovanje i prigovor iznajmljivača (ulazna pismena; slugovi ocitovanje-suspenzije, prigovor-suspenzije,
# ocitovanje-povlacenja, prigovor-povlacenja): šifra ili naziv ULAZNE vrste u eGOP-u, jer je fallback izlazni.
#EGOP_SIFRA_PISMENA_OCITOVANJE_SUSPENZIJE=
#EGOP_NAZIV_PISMENA_OCITOVANJE_SUSPENZIJE=
#EGOP_SIFRA_PISMENA_PRIGOVOR_SUSPENZIJE=
#EGOP_NAZIV_PISMENA_PRIGOVOR_SUSPENZIJE=
#EGOP_SIFRA_PISMENA_OCITOVANJE_POVLACENJA=
#EGOP_NAZIV_PISMENA_OCITOVANJE_POVLACENJA=
#EGOP_SIFRA_PISMENA_PRIGOVOR_POVLACENJA=
#EGOP_NAZIV_PISMENA_PRIGOVOR_POVLACENJA=
# Vrsta priloga uz pismena (T17, KreirajPrilogIPridruziDokument): šifra iz MDM šifrarnika vrsta
# priloga (DohvatiVrstePrilogaActive) ili naziv koji se u njemu razrješava (default „Prilog").
# Uz EGOP_ENABLED=true provjerava se pri startu: startup_egop_prilog_unresolved u logu znači da akti
# idu u eGOP/KP BEZ priloga, a prilozi se iscrpe u retryju (egop_prilog_retry_exhausted). Naziv ne
# ostavljati praznim — prazna vrijednost pregazi default. Otvoreno pitanje za InfoDom: najveći SOAP
# zahtjev koji eGOP prima — prilog od 10 MB je ~13,4 MB base64 u jednom KreirajPrilogIPridruziDokument.
#EGOP_SIFRA_PRILOGA=
#EGOP_NAZIV_PRILOGA=Prilog

# Žurna verifikacija (T8): RB izdan za neverificiran eTurizam objekt → str.verification_request
# (+ obavijesti službenicima). Lokalno tablice daje changeset 152 (context=local).
#STR_ETURIZAM_VERIFIKACIJA_ENABLED=false
#STR_ETURIZAM_VERIFIKACIJA_KORISNIK=STR
# Najdulje trajanje pokušaja (i čekanja na zaključan redak): retry job / prvi pokušaj na niti HTTP
# zahtjeva. Istek je običan neuspjeh. Zadane vrijednosti su u EturizamVerifikacijaProperties.
#STR_ETURIZAM_VERIFIKACIJA_TIMEOUT=PT10S
#STR_ETURIZAM_VERIFIKACIJA_INLINE_TIMEOUT=PT3S
# Obavijesti službenicima nadležne jedinice (str.korisnicka_obavijest). Vrsta, objekt_tip i tekst
# eTurizam još nije potvrdio — paliti tek nakon potvrde. Tekst: {rn} = RB, {objekt} = naziv/mjesto/ID.
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_ENABLED=false
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_VRSTA=VERIFIKACIJA_ZATRAZENA
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_OBJEKT_TIP=VERIFIKACIJA_RJESENJA
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_TEKST=
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_TEKST_NOVI_OBJEKT=
# Najviše obavijesti po zahtjevu (aktivnih internih korisnika jedinice); iznad toga WARN i prvih toliko.
#STR_ETURIZAM_VERIFIKACIJA_OBAVIJESTI_MAX_PRIMATELJA=200
# Retry (EturizamVerifikacijaRetryJob): backoff 5 min … 2 h, nakon max-attempts ABANDONED + ERROR.
# Bez prava (permission denied) pokušaji se ne troše; redak čeka PENDING.
#STR_ETURIZAM_VERIFIKACIJA_RETRY_CRON=0 */5 * * * *
#STR_ETURIZAM_VERIFIKACIJA_RETRY_MAX_ATTEMPTS=10
#STR_ETURIZAM_VERIFIKACIJA_RETRY_BACKOFF_BASE=PT5M
#STR_ETURIZAM_VERIFIKACIJA_RETRY_BACKOFF_MAX=PT2H

# Adresa korisničkog pretinca za poveznicu u porukama iznajmljivaču s pretincem (apsolutni http(s) URL).
# Nepostavljeno = poruka ide bez poveznice. Točna adresa još nije potvrđena.
#APP_MAIL_KP_URL=
