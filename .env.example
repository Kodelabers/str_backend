# Draft encryption key (AES-256, base64-encoded 32 bytes). Generate with:
#     openssl rand -base64 32
DRAFT_ENC_KEY=CHANGE_ME_base64_32_bytes

# eGOP (uz EGOP_ENABLED=true; lokalno radi mock).
# Vrsta priloga uz pismena (T17, KreirajPrilogIPridruziDokument): šifra iz MDM šifrarnika vrsta
# priloga (DohvatiVrstePrilogaActive) ili naziv koji se u njemu razrješava (default „Prilog").
# Uz EGOP_ENABLED=true provjerava se pri startu: startup_egop_prilog_unresolved u logu znači da akti
# idu u eGOP/KP BEZ priloga, a prilozi se iscrpe u retryju (egop_prilog_retry_exhausted). Naziv ne
# ostavljati praznim — prazna vrijednost pregazi default. Otvoreno pitanje za InfoDom: najveći SOAP
# zahtjev koji eGOP prima — prilog od 10 MB je ~13,4 MB base64 u jednom KreirajPrilogIPridruziDokument.
#EGOP_SIFRA_PRILOGA=
#EGOP_NAZIV_PRILOGA=Prilog
