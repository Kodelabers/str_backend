<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      Kvalificirani e-pečat izlaznih akata (STR eSeal API, str.eseal.*). Izlazni akt se pečatira
      prije prilaganja u eGOP, pa pečaćeni PDF zamjenjuje nepečaćeni u pdf_content.

      seal_idempotency_key se upisuje prije prvog poziva, zajedno s bajtovima koji se šalju: retry s
      istim ključem i istim bajtovima dobiva spremljeni pečat umjesto novog. Briše se samo nakon
      konačnog odbijanja, kad sljedeći pokušaj ide s novim dokumentom. sealed_at NULL = nije pečatiran.
      seal_control_number je tajna (s GUID-om otvara dokument na eSeal servisu) — ne izlaže se na API-ju.
    -->
    <changeSet id="147-egop-pismeno-eseal" author="str-backend">
        <addColumn schemaName="str_rn" tableName="egop_pismeno">
            <column name="seal_idempotency_key" type="VARCHAR(64)"/>
            <column name="seal_document_guid" type="UUID"/>
            <column name="seal_control_number" type="VARCHAR(16)"/>
            <column name="seal_level" type="VARCHAR(8)"/>
            <column name="seal_digest" type="VARCHAR(80)"/>
            <column name="sealed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
