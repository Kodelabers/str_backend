<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="003-create-accommodation-type" author="str-backend">
        <createTable schemaName="str_rn" tableName="accommodation_type"
                     remarks="Vrsta smještajnog sadržaja (Apartman, Soba, Kamp, Studio apartman...)">
            <column name="type_id" type="BIGINT" autoIncrement="true"
                    remarks="Interni ID vrste smještaja (PK)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"
                    remarks="Naziv vrste smještaja">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback><dropTable schemaName="str_rn" tableName="accommodation_type"/></rollback>
    </changeSet>

</databaseChangeLog>
