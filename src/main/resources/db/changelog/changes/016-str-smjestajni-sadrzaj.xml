<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      STR funkcionalna specifikacija §6.2 C "Smjestajni sadrzaji objekta":
      individual rooms/apartments inside an SSO. RB is assigned per smjestajni_sadrzaj
      for Soba/Apartman/Studio Apartman types (not at SSO level).
    -->
    <changeSet id="016-create-smjestajni-sadrzaj" author="str-backend">
        <createTable schemaName="str" tableName="smjestajni_sadrzaj">
            <column name="id_smjestajnog_sadrzaja" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_sso" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_ss_sso"
                             references="str.sso(id_sso)"/>
            </column>
            <column name="vrsta_sadrzaja" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="oznaka" type="VARCHAR(64)"/>
            <column name="broj_kreveta" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="broj_jednakih" type="INTEGER" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="kat" type="VARCHAR(8)"/>
            <column name="kategorija" type="VARCHAR(32)"/>
            <column name="ponuda" type="VARCHAR(16)"/>
            <column name="boraviste_iznajmljivaca" type="BOOLEAN"/>
            <column name="suglasnost_suvlasnika" type="BOOLEAN"/>
            <column name="datum_suglasnosti" type="DATE"/>
            <column name="datum_povlacenja_suglasnosti" type="DATE"/>
            <column name="rb" type="VARCHAR(18)"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE str.smjestajni_sadrzaj
                ADD CONSTRAINT chk_ss_ponuda
                    CHECK (ponuda IS NULL OR ponuda IN ('DIO', 'CJELINA')),
                ADD CONSTRAINT chk_ss_rb_format
                    CHECK (rb IS NULL OR rb ~ '^HR[0-9]{8}$'),
                ADD CONSTRAINT chk_ss_broj_kreveta_pos
                    CHECK (broj_kreveta &gt; 0),
                ADD CONSTRAINT chk_ss_broj_jednakih_pos
                    CHECK (broj_jednakih &gt; 0)
        </sql>

        <createIndex schemaName="str" tableName="smjestajni_sadrzaj" indexName="idx_ss_sso">
            <column name="id_sso"/>
        </createIndex>
        <createIndex schemaName="str" tableName="smjestajni_sadrzaj" indexName="idx_ss_rb">
            <column name="rb"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="str" tableName="smjestajni_sadrzaj"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
