<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- Registracijski broj (RB) / Registration number -->
    <changeSet id="007-create-str-rb" author="str-backend">
        <createTable schemaName="str_rn" tableName="registration_number">
            <column name="rn" type="VARCHAR(18)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="submission_id" type="UUID">
                <constraints foreignKeyName="fk_rn_submission"
                             references="str.submission(submission_id)"/>
            </column>
            <column name="accommodation_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_rn_accommodation"
                             references="str.accommodation(accommodation_id)"/>
            </column>
            <column name="status" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="issue_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="valid_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="valid_to" type="DATE"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE str.registration_number
                ADD CONSTRAINT chk_rn_format
                    CHECK (rn ~ '^HR[0-9]{8}$'),
                ADD CONSTRAINT chk_rn_status
                    CHECK (status IN ('IN_PROCESSING', 'ACTIVE', 'SUSPENDED', 'WITHDRAWN'))
        </sql>

        <createIndex schemaName="str_rn" tableName="registration_number" indexName="idx_rn_accommodation">
            <column name="accommodation_id"/>
        </createIndex>
        <createIndex schemaName="str_rn" tableName="registration_number" indexName="idx_rn_status">
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="str_rn" tableName="registration_number"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
