<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="020-accommodation-type-add-skupina" author="str-backend">
        <addColumn schemaName="str_rn" tableName="accommodation_type">
            <column name="skupina" type="VARCHAR(64)" defaultValue="ostalo">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Re-seeds local/mock only — gated because dev/prod may have FK-linked rows -->
    <changeSet id="020-accommodation-type-reseed" author="str-backend" context="local">
        <delete schemaName="str_rn" tableName="accommodation_type"/>
        <insert schemaName="str_rn" tableName="accommodation_type">
            <column name="name" value="Kuća za odmor"/>
            <column name="registration_number_allowed" valueBoolean="true"/>
            <column name="skupina" value="domacinstvo"/>
        </insert>
        <insert schemaName="str_rn" tableName="accommodation_type">
            <column name="name" value="Apartman"/>
            <column name="registration_number_allowed" valueBoolean="true"/>
            <column name="skupina" value="domacinstvo"/>
        </insert>
        <insert schemaName="str_rn" tableName="accommodation_type">
            <column name="name" value="Studio apartman"/>
            <column name="registration_number_allowed" valueBoolean="true"/>
            <column name="skupina" value="domacinstvo"/>
        </insert>
        <insert schemaName="str_rn" tableName="accommodation_type">
            <column name="name" value="Soba"/>
            <column name="registration_number_allowed" valueBoolean="true"/>
            <column name="skupina" value="domacinstvo"/>
        </insert>
        <insert schemaName="str_rn" tableName="accommodation_type">
            <column name="name" value="Vila"/>
            <column name="registration_number_allowed" valueBoolean="true"/>
            <column name="skupina" value="domacinstvo"/>
        </insert>
        <insert schemaName="str_rn" tableName="accommodation_type">
            <column name="name" value="Kamp odmorište"/>
            <column name="registration_number_allowed" valueBoolean="false"/>
            <column name="skupina" value="kamp"/>
        </insert>
        <insert schemaName="str_rn" tableName="accommodation_type">
            <column name="name" value="Mobilna kućica"/>
            <column name="registration_number_allowed" valueBoolean="false"/>
            <column name="skupina" value="kamp"/>
        </insert>
        <insert schemaName="str_rn" tableName="accommodation_type">
            <column name="name" value="Plovni objekt"/>
            <column name="registration_number_allowed" valueBoolean="false"/>
            <column name="skupina" value="nautika"/>
        </insert>
        <rollback/><!-- seed-only changeset; rollback to empty is acceptable -->
    </changeSet>

</databaseChangeLog>
