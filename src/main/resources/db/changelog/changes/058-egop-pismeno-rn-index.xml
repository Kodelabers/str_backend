<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      Prikaz „Moji registracijski brojevi" dohvaća akte po RB-u
      (RnDocumentsService → findByRnOrderByCreatedAtAsc). Bez indeksa na rn to je
      sekvencijalni scan tablice po svakom otvaranju RB-a.
    -->
    <changeSet id="058-egop-pismeno-rn-index" author="str-backend">
        <createIndex schemaName="str_rn" tableName="egop_pismeno" indexName="ix_egop_pismeno_rn">
            <column name="rn"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
