<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="004-create-str-iznajmljivac" author="str-backend">
        <createTable schemaName="str" tableName="iznajmljivac">
            <column name="id_iznajmljivaca" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="oib_zastupnika" type="CHAR(11)"/>
            <column name="ime" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="prezime" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="naziv_pravne_osobe" type="VARCHAR(255)"/>
            <column name="ulica" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="kucni_broj" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="mjesto" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="zupanija" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="ime_kontakta" type="VARCHAR(255)"/>
            <column name="broj_telefona" type="VARCHAR(32)"/>
            <column name="broj_mobitela" type="VARCHAR(32)"/>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="zastupnik_pravne_osobe" type="VARCHAR(255)"/>
            <column name="email_zastupnika" type="VARCHAR(255)"/>
            <column name="telefon_zastupnika" type="VARCHAR(32)"/>
            <column name="korisnicko_ime" type="VARCHAR(128)">
                <constraints unique="true" uniqueConstraintName="uq_iznajmljivac_korisnicko_ime"/>
            </column>
            <column name="lozinka_hash" type="VARCHAR(255)"/>
            <column name="id_sluzbene_osobe" type="VARCHAR(64)"/>
            <column name="status_prijave" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE str.iznajmljivac
                ADD CONSTRAINT chk_iznajmljivac_oib_format
                    CHECK (oib_zastupnika IS NULL OR oib_zastupnika ~ '^[0-9]{11}$'),
                ADD CONSTRAINT chk_iznajmljivac_status_prijave
                    CHECK (status_prijave IN ('AKTIVAN', 'NEAKTIVAN', 'U_VERIFIKACIJI'))
        </sql>

        <rollback>
            <dropTable schemaName="str" tableName="iznajmljivac"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
