<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="039-registration-number-prefill" author="str-backend">
        <createTable schemaName="str_rn" tableName="registration_number_prefill"
                     remarks="Short-lived prefill payload delivered by a trusted upstream portal (NIAS-authenticated) for the registration-number request flow. Frontend retrieves it once by UUID after redirect.">
            <column name="prefill_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="oib" type="VARCHAR(11)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="address_code" type="VARCHAR(64)"
                    remarks="Stable šifra of the house number from the upstream address registry; resolved to full address chain on read"/>
            <column name="max_bed_count" type="INTEGER"/>
            <column name="max_guest_count" type="INTEGER"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex schemaName="str_rn" tableName="registration_number_prefill"
                     indexName="idx_registration_number_prefill_created_at">
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="str_rn" tableName="registration_number_prefill"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
