<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      STR funkcionalna specifikacija §6.1.3 "Imena svih pravnih zastupnika pravne
      osobe" and §6.1.4 "Adrese svih pravnih zastupnika". Per spec a pravna osoba
      can have multiple legal representatives pulled from the Sudski registar (GO-5),
      not just the single zastupnik already modeled on iznajmljivac.
    -->
    <changeSet id="019-create-zastupnici-pravne-osobe" author="str-backend">
        <createTable schemaName="str" tableName="zastupnik_pravne_osobe">
            <column name="id_zastupnika" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_iznajmljivaca" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_zastupnik_iznajmljivac"
                             references="str.iznajmljivac(id_iznajmljivaca)"/>
            </column>
            <column name="oib" type="CHAR(11)"/>
            <column name="ime" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="prezime" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="adresa" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="telefon" type="VARCHAR(32)"/>
            <column name="izvor" type="VARCHAR(32)" defaultValue="SUDSKI_REGISTAR">
                <constraints nullable="false"/>
            </column>
            <column name="dohvaceno_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE str.zastupnik_pravne_osobe
                ADD CONSTRAINT chk_zastupnik_oib_format
                    CHECK (oib IS NULL OR oib ~ '^[0-9]{11}$'),
                ADD CONSTRAINT chk_zastupnik_izvor
                    CHECK (izvor IN ('SUDSKI_REGISTAR', 'RUCNI_UNOS'))
        </sql>

        <createIndex schemaName="str" tableName="zastupnik_pravne_osobe" indexName="idx_zastupnik_iznajmljivac">
            <column name="id_iznajmljivaca"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="str" tableName="zastupnik_pravne_osobe"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
