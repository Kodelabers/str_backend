    <!--
        Per-country breakdown za svaku aktivnost. Profil 'zg' (Zagreb, city/business) ima
        DE/AT/US dominantne goste; 'coast' (priobalni) ima DE/IT/AT. Postoci se primijene
        na ukupan guest_count aktivnosti, zaokruženi naviše (najmanje 1 ako share > 0).
    -->
    <changeSet id="036-seed-mock-guests" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM str_rn.accommodation_activity WHERE activity_id = 'a0000000-0000-0000-0101-010000000000'
                </sqlCheck>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM str_rn.guest WHERE activity_id = 'a0000000-0000-0000-0101-010000000000'
                </sqlCheck>
            </and>
        </preConditions>
        <sql>
            INSERT INTO str_rn.guest (guest_id, activity_id, country, guest_count)
            SELECT
                gen_random_uuid(),
                aa.activity_id,
                cs.country,
                GREATEST(1, CEIL(aa.guest_count * cs.share)::INT)
            FROM str_rn.accommodation_activity aa
            JOIN (VALUES
                ('zg',    'DE', 0.55),
                ('zg',    'AT', 0.25),
                ('zg',    'US', 0.20),
                ('coast', 'DE', 0.45),
                ('coast', 'IT', 0.25),
                ('coast', 'AT', 0.20),
                ('coast', 'SI', 0.10)
            ) AS cs(profile, country, share)
              ON cs.profile = CASE WHEN aa.rn = 'HR010001A0B0C0D0E0F0' THEN 'zg' ELSE 'coast' END
            WHERE aa.activity_id::text LIKE 'a0000000-0000-0000-%'
              AND aa.guest_count > 0;
        </sql>
        <rollback>
            <sql>
                DELETE FROM str_rn.guest
                WHERE activity_id IN (SELECT activity_id FROM str_rn.accommodation_activity WHERE activity_id::text LIKE 'a0000000-0000-0000-%')
            </sql>
        </rollback>
    </changeSet>

