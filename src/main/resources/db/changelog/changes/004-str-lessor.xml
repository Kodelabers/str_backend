<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="004-create-str-lessor" author="str-backend">
        <validCheckSum>ANY</validCheckSum>
        <createTable schemaName="str_rn" tableName="lessor"
                     remarks="Iznajmljivač — fizička ili pravna osoba koja podnosi zahtjev za STR registraciju">
            <column name="lessor_id" type="UUID"
                    remarks="UUID iznajmljivača (PK, generira se pri kreaciji)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lessor_oib" type="CHAR(11)"
                    remarks="OIB iznajmljivača (11 znamenki; fizička osoba)"/>
            <column name="representative_oib" type="CHAR(11)"
                    remarks="OIB pravne osobe ili zastupnika (11 znamenki; null za fizičke osobe)"/>
            <column name="first_name" type="VARCHAR(128)"
                    remarks="Ime iznajmljivača">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(128)"
                    remarks="Prezime iznajmljivača">
                <constraints nullable="false"/>
            </column>
            <column name="legal_entity_name" type="VARCHAR(255)"
                    remarks="Naziv pravne osobe (popunjava se za pravne osobe, dohvaća se iz sudskog registra)"/>
            <column name="street" type="VARCHAR(128)"
                    remarks="Ulica adrese stanovanja iznajmljivača">
                <constraints nullable="false"/>
            </column>
            <column name="street_number" type="VARCHAR(16)"
                    remarks="Kućni broj adrese iznajmljivača">
                <constraints nullable="false"/>
            </column>
            <column name="place" type="VARCHAR(128)"
                    remarks="Grad ili općina prebivališta iznajmljivača">
                <constraints nullable="false"/>
            </column>
            <column name="county" type="VARCHAR(128)"
                    remarks="Županija prebivališta iznajmljivača">
                <constraints nullable="false"/>
            </column>
            <column name="contact_name" type="VARCHAR(255)"
                    remarks="Ime i prezime kontakt osobe (ako se razlikuje od iznajmljivača)"/>
            <column name="phone_number" type="VARCHAR(32)"
                    remarks="Broj fiksnog telefona"/>
            <column name="mobile_number" type="VARCHAR(32)"
                    remarks="Broj mobitela"/>
            <column name="email" type="VARCHAR(255)"
                    remarks="E-mail adresa iznajmljivača">
                <constraints nullable="false"/>
            </column>
            <column name="legal_representative_name" type="VARCHAR(255)"
                    remarks="Ime i prezime zakonskog zastupnika pravne osobe"/>
            <column name="representative_email" type="VARCHAR(255)"
                    remarks="E-mail adresa zakonskog zastupnika"/>
            <column name="representative_phone" type="VARCHAR(32)"
                    remarks="Telefon zakonskog zastupnika"/>
            <column name="representative_address" type="VARCHAR(255)"
                    remarks="Adresa zakonskog zastupnika"/>
            <column name="contact_note" type="VARCHAR(1024)"
                    remarks="Napomena uz kontakt podatke"/>
            <column name="official_person_id" type="VARCHAR(64)"
                    remarks="Identifikator korisnika iz NIAS sustava autentifikacije"/>
            <column name="application_status" type="VARCHAR(32)"
                    remarks="Current registration application status for this lessor (Status_prijave)"/>
            <column name="created_at" type="TIMESTAMPTZ"
                    remarks="Datum i vrijeme kreiranja zapisa">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"
                    remarks="Datum i vrijeme zadnje izmjene zapisa">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE str_rn.lessor
                ADD CONSTRAINT chk_lessor_oib_format
                    CHECK (
                        (lessor_oib IS NULL OR lessor_oib ~ '^[0-9]{11}$') AND
                        (representative_oib IS NULL OR representative_oib ~ '^[0-9]{11}$')
                    ),
                ADD CONSTRAINT chk_lessor_application_status
                    CHECK (application_status IS NULL OR application_status IN (
                        'INITIATED', 'IN_VERIFICATION', 'IN_PROCESSING', 'ACCEPTED', 'REJECTED'
                    ))
        </sql>

        <rollback>
            <dropTable schemaName="str_rn" tableName="lessor"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
