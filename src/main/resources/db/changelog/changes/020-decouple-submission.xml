<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      STR §5/§6 redesign: RB se izdaje izravno na SSO razini, bez Zahtjeva kao
      perzistentnog workflow entiteta. submission_id ostaje (audit trag), ali postaje
      nullable na registration_number i accommodation da bi novi RegistrationService
      mogao raditi mimo submission tablice.
    -->
    <changeSet id="020-rb-id-zahtjeva-nullable" author="str-backend">
        <dropNotNullConstraint schemaName="str_rn" tableName="registration_number" columnName="submission_id"/>
        <rollback>
            <addNotNullConstraint schemaName="str_rn" tableName="registration_number" columnName="submission_id"/>
        </rollback>
    </changeSet>

    <changeSet id="020-sso-id-zahtjeva-nullable" author="str-backend">
        <dropNotNullConstraint schemaName="str_rn" tableName="accommodation" columnName="submission_id"/>
        <rollback>
            <addNotNullConstraint schemaName="str_rn" tableName="accommodation" columnName="submission_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
