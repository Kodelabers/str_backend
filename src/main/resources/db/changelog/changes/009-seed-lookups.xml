<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- nadlezno_tijelo — tourist inspection bodies per ZAK -->
    <changeSet id="009-seed-nadlezno-tijelo" author="str-backend">
        <insert schemaName="str" tableName="nadlezno_tijelo">
            <column name="naziv" value="Turistička inspekcija Zagreb"/>
        </insert>
        <insert schemaName="str" tableName="nadlezno_tijelo">
            <column name="naziv" value="Turistička inspekcija Split"/>
        </insert>
        <insert schemaName="str" tableName="nadlezno_tijelo">
            <column name="naziv" value="Turistička inspekcija Rijeka"/>
        </insert>
        <insert schemaName="str" tableName="nadlezno_tijelo">
            <column name="naziv" value="Turistička inspekcija Osijek"/>
        </insert>
        <insert schemaName="str" tableName="nadlezno_tijelo">
            <column name="naziv" value="Turistička inspekcija Zadar"/>
        </insert>
        <rollback>
            <delete schemaName="str" tableName="nadlezno_tijelo"/>
        </rollback>
    </changeSet>

    <!-- vrsta_zahtjeva — STR registration request types per ZAK -->
    <changeSet id="009-seed-vrsta-zahtjeva" author="str-backend">
        <insert schemaName="str" tableName="vrsta_zahtjeva">
            <column name="oznaka_vrste" value="NOVA_REGISTRACIJA"/>
            <column name="kodna_oznaka" value="NR"/>
            <column name="naziv" value="Nova registracija smještajne jedinice"/>
            <column name="datum_od" valueDate="2024-01-01"/>
            <column name="datum_do"/>
            <column name="status" value="AKTIVAN"/>
        </insert>
        <insert schemaName="str" tableName="vrsta_zahtjeva">
            <column name="oznaka_vrste" value="PROMJENA_PODATAKA"/>
            <column name="kodna_oznaka" value="PP"/>
            <column name="naziv" value="Promjena podataka o smještajnoj jedinici"/>
            <column name="datum_od" valueDate="2024-01-01"/>
            <column name="datum_do"/>
            <column name="status" value="AKTIVAN"/>
        </insert>
        <insert schemaName="str" tableName="vrsta_zahtjeva">
            <column name="oznaka_vrste" value="OBNOVA"/>
            <column name="kodna_oznaka" value="OB"/>
            <column name="naziv" value="Obnova rješenja o kategorizaciji"/>
            <column name="datum_od" valueDate="2024-01-01"/>
            <column name="datum_do"/>
            <column name="status" value="AKTIVAN"/>
        </insert>
        <rollback>
            <delete schemaName="str" tableName="vrsta_zahtjeva"/>
        </rollback>
    </changeSet>

    <!-- vrsta_sso — accommodation unit types per ZAK -->
    <changeSet id="009-seed-vrsta-sso" author="str-backend">
        <insert schemaName="str" tableName="vrsta_sso">
            <column name="naziv" value="Soba"/>
        </insert>
        <insert schemaName="str" tableName="vrsta_sso">
            <column name="naziv" value="Apartman"/>
        </insert>
        <insert schemaName="str" tableName="vrsta_sso">
            <column name="naziv" value="Studio apartman"/>
        </insert>
        <insert schemaName="str" tableName="vrsta_sso">
            <column name="naziv" value="Kuca za odmor"/>
        </insert>
        <insert schemaName="str" tableName="vrsta_sso">
            <column name="naziv" value="Vila"/>
        </insert>
        <rollback>
            <delete schemaName="str" tableName="vrsta_sso"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
