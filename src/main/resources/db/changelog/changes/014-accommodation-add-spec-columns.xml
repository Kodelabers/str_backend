<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- Funkcionalna specifikacija STR §6.2 / §11: fields required by the registration form. -->
    <changeSet id="014-sso-add-spec-columns" author="str-backend">
        <addColumn schemaName="str_rn" tableName="accommodation">
            <column name="name" type="VARCHAR(255)"/>
            <column name="group_name" type="VARCHAR(128)"/>
            <column name="requested_category" type="VARCHAR(32)"/>
            <column name="category" type="VARCHAR(32)"/>
            <column name="description" type="VARCHAR(1024)"/>
            <column name="brko" type="VARCHAR(64)"/>
            <column name="note" type="VARCHAR(1024)"/>
            <column name="auxiliary_beds" type="INTEGER"/>
            <column name="lessor_domicile" type="BOOLEAN"/>
        </addColumn>
        <rollback>
            <dropColumn schemaName="str_rn" tableName="accommodation" columnName="name"/>
            <dropColumn schemaName="str_rn" tableName="accommodation" columnName="group_name"/>
            <dropColumn schemaName="str_rn" tableName="accommodation" columnName="requested_category"/>
            <dropColumn schemaName="str_rn" tableName="accommodation" columnName="category"/>
            <dropColumn schemaName="str_rn" tableName="accommodation" columnName="description"/>
            <dropColumn schemaName="str_rn" tableName="accommodation" columnName="brko"/>
            <dropColumn schemaName="str_rn" tableName="accommodation" columnName="note"/>
            <dropColumn schemaName="str_rn" tableName="accommodation" columnName="auxiliary_beds"/>
            <dropColumn schemaName="str_rn" tableName="accommodation" columnName="lessor_domicile"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
