<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      Lokalni mock za str.document_contact — samo kontaktna polja potrebna za predpopunu
      obrasca za RB. Na dev/CDU/preprod tablicu posjeduje eTurizam i read-only je.
    -->
    <changeSet id="133-str-document-contact-local" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="document_contact"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="document_contact">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="document_id" type="BIGINT"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="mobile" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
