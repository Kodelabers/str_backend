<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="009-seed-online-platform" author="str-backend">
        <!-- Global major platforms -->
        <insert schemaName="str_rn" tableName="online_platform">
            <column name="name" value="Airbnb"/>
            <column name="url" value="https://www.airbnb.com"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert schemaName="str_rn" tableName="online_platform">
            <column name="name" value="Booking.com"/>
            <column name="url" value="https://www.booking.com"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <rollback>
            <delete schemaName="str_rn" tableName="online_platform"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
