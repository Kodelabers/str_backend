<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      Changeset 056 je dodao status SUSPENSION_PROPOSED (19 znakova), ali kolone
      koje drže naziv statusa ostale su VARCHAR(16):
        - registration_number.status
        - registration_number_log.from_status / to_status
      Zato suspenzija puca na urudžbi zapisa u revizijski log
      (22001: value too long for type character varying(16)). Proširujemo na
      VARCHAR(32) da stane i ovaj i eventualni budući duži statusi.
    -->
    <changeSet id="059-widen-rn-status-columns" author="str-backend">
        <modifyDataType schemaName="str_rn" tableName="registration_number"
                        columnName="status" newDataType="VARCHAR(32)"/>
        <modifyDataType schemaName="str_rn" tableName="registration_number_log"
                        columnName="from_status" newDataType="VARCHAR(32)"/>
        <modifyDataType schemaName="str_rn" tableName="registration_number_log"
                        columnName="to_status" newDataType="VARCHAR(32)"/>
    </changeSet>

</databaseChangeLog>
