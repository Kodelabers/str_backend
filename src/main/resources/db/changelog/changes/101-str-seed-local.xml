<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      Seed data for local mock 'str' schema. Test OIB 12312312316 → Pero Perić.

      Address-hierarchy and country seeds (county/municipality/settlement/street/
      house_number/address/country) have moved to rpj_dgu + eturizam_test schemas
      and are seeded in a separate changelog (TBD). Subject seeds below intentionally
      reference address_id values that no longer resolve locally — StrLessorLookupService
      will fail with "Adresa iznajmljivača nije pronađena" until the GIS mock is added.
    -->

    <changeSet id="101-str-seed-subject" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM str.subject WHERE id = 1</sqlCheck>
        </preConditions>
        <!-- Test lessor: OIB 12312312316 → Pero Perić -->
        <insert schemaName="str" tableName="subject">
            <column name="id" valueNumeric="1"/>
            <column name="active" valueBoolean="true"/>
            <column name="jips" value="12312312316"/>
        </insert>
        <insert schemaName="str" tableName="subject_version">
            <column name="id" valueNumeric="1"/>
            <column name="active" valueBoolean="true"/>
            <column name="subject_id" valueNumeric="1"/>
            <column name="first_name" value="Pero"/>
            <column name="last_name" value="Perić"/>
            <column name="pin" value="12312312316"/>
            <column name="historical" valueBoolean="false"/>
        </insert>
        <insert schemaName="str" tableName="subject_address">
            <column name="id" valueNumeric="1"/>
            <column name="active" valueBoolean="true"/>
            <column name="subject_version_id" valueNumeric="1"/>
            <column name="address_id" valueNumeric="1"/>
        </insert>
    </changeSet>

    <changeSet id="101-str-seed-subjects-extra" author="str-backend" context="local">
