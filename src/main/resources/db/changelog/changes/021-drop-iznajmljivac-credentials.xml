<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      STR funkcionalna specifikacija §3 / §4: prijava ide preko NIAS/eID; STR ne čuva
      credentialse niti vlastiti status prijave. Kanal upita više nije relevantan jer
      svi scenariji idu kroz NIAS preko vanjskog/internog portala.
    -->
    <changeSet id="021-iznajmljivac-drop-credentials" author="str-backend">
        <dropColumn schemaName="str" tableName="iznajmljivac" columnName="korisnicko_ime"/>
        <dropColumn schemaName="str" tableName="iznajmljivac" columnName="lozinka_hash"/>
        <dropColumn schemaName="str" tableName="iznajmljivac" columnName="status_prijave"/>
        <rollback>
            <addColumn schemaName="str" tableName="iznajmljivac">
                <column name="korisnicko_ime" type="VARCHAR(128)"/>
                <column name="lozinka_hash" type="VARCHAR(255)"/>
                <column name="status_prijave" type="VARCHAR(32)"/>
            </addColumn>
        </rollback>
    </changeSet>

    <changeSet id="021-zahtjev-drop-kanal" author="str-backend">
        <dropColumn schemaName="str" tableName="zahtjev" columnName="kanal"/>
        <rollback>
            <addColumn schemaName="str" tableName="zahtjev">
                <column name="kanal" type="VARCHAR(16)"/>
            </addColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
