<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- STR funkcionalna specifikacija §6.2 A: "Napomena kontakta" as part of kontakt podaci. -->
    <changeSet id="015-iznajmljivac-add-napomena-kontakta" author="str-backend">
        <addColumn schemaName="str_rn" tableName="lessor">
            <column name="contact_note" type="VARCHAR(1024)"/>
            <column name="representative_address" type="VARCHAR(255)"/>
        </addColumn>
        <rollback>
            <dropColumn schemaName="str_rn" tableName="lessor" columnName="contact_note"/>
            <dropColumn schemaName="str_rn" tableName="lessor" columnName="representative_address"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
