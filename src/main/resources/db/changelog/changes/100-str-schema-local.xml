<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      Mock of the externally-owned 'str' schema for local development only.
      In dev/prod 'str.*' is owned by another service; we read from it but never write.
      Locally we recreate just the columns the code consumes.

      INTENTIONALLY LOOSE SCHEMA: FK constraints and NOT NULLs are omitted to keep
      the mock simple. This means invalid data can be inserted locally without error.
      All write paths that reference str.* tables must be validated against the dev
      profile before merging to main.

      Every createTable is guarded by a preCondition so that re-running against a
      database where the table already exists (e.g. Railway after a partial deploy)
      marks the changeset as RAN instead of failing on duplicate relation errors.
    -->

    <changeSet id="100-str-schema" author="str-backend" context="local">
        <sql>CREATE SCHEMA IF NOT EXISTS str</sql>
    </changeSet>

    <changeSet id="100-str-country" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="country"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="country">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="iso2_alpha" type="VARCHAR(2)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="100-str-county" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="county"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="county">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="100-str-municipality" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="municipality"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="municipality">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="county_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="type_code" type="VARCHAR(16)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="100-str-settlement" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="settlement"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="settlement">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="postal_code" type="VARCHAR(16)"/>
            <column name="municipality_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="100-str-street" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="street"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="street">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="settlement_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="type_code" type="VARCHAR(16)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="100-str-house-number" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="house_number"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="house_number">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="street_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="100-str-address" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="address"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="address">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="country_id" type="BIGINT"/>
            <column name="settlement_id" type="BIGINT"/>
            <column name="street_id" type="BIGINT"/>
            <column name="house_number_id" type="BIGINT"/>
            <column name="county" type="VARCHAR(128)"/>
            <column name="county_id" type="BIGINT"/>
            <column name="municipality" type="VARCHAR(128)"/>
            <column name="municipality_id" type="BIGINT"/>
            <column name="postal_code" type="VARCHAR(16)"/>
            <column name="settlement" type="VARCHAR(128)"/>
            <column name="street" type="VARCHAR(128)"/>
            <column name="house_number" type="VARCHAR(32)"/>
            <column name="full_address" type="VARCHAR(512)"/>
            <column name="address_description" type="VARCHAR(512)"/>
        </createTable>
    </changeSet>

    <changeSet id="100-str-subject" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="subject"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="subject">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="subtype_id" type="BIGINT"/>
            <column name="jips" type="VARCHAR(32)"/>
            <column name="jips_source_id" type="BIGINT"/>
        </createTable>
        <createIndex schemaName="str" tableName="subject" indexName="idx_str_subject_jips_active">
            <column name="jips"/>
            <column name="active"/>
        </createIndex>
    </changeSet>

    <changeSet id="100-str-subject-version" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="subject_version"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="subject_version">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="first_name" type="VARCHAR(128)"/>
            <column name="last_name" type="VARCHAR(128)"/>
            <column name="country_id" type="BIGINT"/>
            <column name="subject_id" type="BIGINT"/>
            <column name="pin" type="VARCHAR(32)"/>
            <column name="date_of_birth" type="DATE"/>
            <column name="historical" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
        <createIndex schemaName="str" tableName="subject_version" indexName="idx_str_subject_version_subject">
            <column name="subject_id"/>
            <column name="active"/>
            <column name="historical"/>
        </createIndex>
    </changeSet>

    <changeSet id="100-str-subject-address" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="subject_address"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="subject_address">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="subject_version_id" type="BIGINT"/>
            <column name="address_type_id" type="BIGINT"/>
            <column name="address_id" type="BIGINT"/>
        </createTable>
        <createIndex schemaName="str" tableName="subject_address" indexName="idx_str_subject_address_version">
            <column name="subject_version_id"/>
            <column name="active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
