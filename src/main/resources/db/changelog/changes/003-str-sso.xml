<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="003-create-str-sso" author="str-backend">
        <createTable schemaName="str" tableName="sso">
            <column name="uuid_sso" type="UUID">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_sso_core_objekt"
                             references="core.objekt(uuid)"/>
            </column>
            <column name="registracijski_broj" type="VARCHAR(18)">
                <constraints unique="true" uniqueConstraintName="uq_sso_registracijski_broj"/>
            </column>
            <column name="kapacitet_kreveta" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="kapacitet_gostiju" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="ponuda" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="kat" type="VARCHAR(8)"/>
            <column name="broj_stana" type="VARCHAR(16)"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE str.sso
                ADD CONSTRAINT chk_sso_rb_format
                    CHECK (registracijski_broj IS NULL OR registracijski_broj ~ '^HR[0-9]{8}$'),
                ADD CONSTRAINT chk_sso_ponuda
                    CHECK (ponuda IN ('DIO', 'CJELINA')),
                ADD CONSTRAINT chk_sso_status
                    CHECK (status IN ('INICIIRAN', 'VALIDACIJA', 'U_OBRADI', 'AKTIVAN', 'SUSPENDIRAN', 'POVUCEN'))
        </sql>

        <createIndex schemaName="str" tableName="sso" indexName="idx_sso_status">
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="str" tableName="sso"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
