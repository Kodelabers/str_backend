<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
        Username sada drži e-mail (do 255 znakova), umjesto generiranog prefiksa.
        Unique constraint uk_lessor_username ostaje na koloni.
    -->
    <changeSet id="034-lessor-username-widen" author="str-backend">
        <modifyDataType schemaName="str_rn" tableName="lessor"
                        columnName="username" newDataType="VARCHAR(255)"/>
    </changeSet>

</databaseChangeLog>
