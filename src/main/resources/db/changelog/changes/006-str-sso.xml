<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="006-create-str-sso" author="str-backend">
        <createTable schemaName="str" tableName="sso">
            <column name="id_sso" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_zahtjeva" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_sso_zahtjev"
                             references="str.zahtjev(id_zahtjeva)"/>
            </column>
            <column name="id_vrste_sso" type="BIGINT">
                <constraints foreignKeyName="fk_sso_vrsta"
                             references="str.vrsta_sso(id_vrste_sso)"/>
            </column>
            <column name="id_core_objekt" type="UUID">
                <constraints foreignKeyName="fk_sso_core"
                             references="core.objekt(uuid)"/>
            </column>
            <column name="oznaka_sso" type="VARCHAR(64)"/>
            <column name="zupanija" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="grad" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="naselje" type="VARCHAR(128)"/>
            <column name="ulica" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="kucni_broj" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="katastarska_opcina" type="VARCHAR(128)"/>
            <column name="broj_katastarske_cestice" type="VARCHAR(64)"/>
            <column name="max_kreveta" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="max_gostiju" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="ponuda" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="boraviste_iznajmljivaca" type="BOOLEAN"/>
            <column name="zgrada" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="kat" type="VARCHAR(8)"/>
            <column name="stanovi" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="legalizirano" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="suglasnost_suvlasnika" type="BOOLEAN"/>
            <column name="datum_suglasnosti" type="DATE"/>
            <column name="datum_povlacenja_suglasnosti" type="DATE"/>
            <column name="domacin" type="BOOLEAN"/>
            <column name="datum_domacina" type="TIMESTAMPTZ"/>
            <column name="datum_povlacenja_dom" type="TIMESTAMPTZ"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE str.sso
                ADD CONSTRAINT chk_sso_ponuda
                    CHECK (ponuda IN ('DIO', 'CJELINA'))
        </sql>

        <createIndex schemaName="str" tableName="sso" indexName="idx_sso_zahtjev">
            <column name="id_zahtjeva"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="str" tableName="sso"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
