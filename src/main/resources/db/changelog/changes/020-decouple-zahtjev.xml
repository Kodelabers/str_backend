<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      STR §5/§6 redesign: RB se izdaje izravno na SSO razini, bez Zahtjeva kao
      perzistentnog workflow entiteta. id_zahtjeva ostaje (audit trag), ali postaje
      nullable na rb i sso da bi novi RegistracijaService mogao raditi mimo Zahtjev tablice.
    -->
    <changeSet id="020-rb-id-zahtjeva-nullable" author="str-backend">
        <dropNotNullConstraint schemaName="str" tableName="rb" columnName="id_zahtjeva"/>
        <rollback>
            <addNotNullConstraint schemaName="str" tableName="rb" columnName="id_zahtjeva"/>
        </rollback>
    </changeSet>

    <changeSet id="020-sso-id-zahtjeva-nullable" author="str-backend">
        <dropNotNullConstraint schemaName="str" tableName="sso" columnName="id_zahtjeva"/>
        <rollback>
            <addNotNullConstraint schemaName="str" tableName="sso" columnName="id_zahtjeva"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
