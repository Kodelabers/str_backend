<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="039-registration-prefill" author="str-backend">
        <createTable schemaName="str_rn" tableName="registration_prefill"
                     remarks="Short-lived prefill payload delivered by a trusted upstream portal (NIAS-authenticated). Frontend retrieves it once by UUID after redirect.">
            <column name="prefill_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="oib" type="VARCHAR(11)">
                <constraints nullable="false"/>
            </column>
            <column name="ime" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="prezime" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="kucni_broj_sifra" type="BIGINT"
                    remarks="eturizam_test.ar_address.id — resolved to full address chain on read"/>
            <column name="broj_kreveta" type="INTEGER"/>
            <column name="broj_gostiju" type="INTEGER"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex schemaName="str_rn" tableName="registration_prefill"
                     indexName="idx_registration_prefill_created_at">
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="str_rn" tableName="registration_prefill"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
