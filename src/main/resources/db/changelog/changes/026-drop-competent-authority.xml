<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
        Nadležno tijelo se dohvaća iz str.internal_organization (core shema).
        Brišemo vlastitu kopiju i FK koji je na nju pokazivao.
    -->
    <changeSet id="026-drop-fk-submission-authority" author="str-backend">
        <dropForeignKeyConstraint baseTableSchemaName="str_rn"
                                  baseTableName="submission"
                                  constraintName="fk_submission_authority"/>
        <rollback>
            <addForeignKeyConstraint baseTableSchemaName="str_rn"
                                     baseTableName="submission"
                                     baseColumnNames="authority_id"
                                     constraintName="fk_submission_authority"
                                     referencedTableSchemaName="str_rn"
                                     referencedTableName="competent_authority"
                                     referencedColumnNames="authority_id"/>
        </rollback>
    </changeSet>

    <changeSet id="026-drop-table-competent-authority" author="str-backend">
        <dropTable schemaName="str_rn" tableName="competent_authority"/>
        <rollback>
            <createTable schemaName="str_rn" tableName="competent_authority">
                <column name="authority_id" type="BIGINT" autoIncrement="true">
                    <constraints primaryKey="true" nullable="false"/>
                </column>
                <column name="name" type="VARCHAR(255)">
                    <constraints nullable="false"/>
                </column>
            </createTable>
        </rollback>
    </changeSet>

</databaseChangeLog>
