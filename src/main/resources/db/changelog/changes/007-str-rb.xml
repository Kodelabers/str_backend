<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="007-create-str-rb" author="str-backend">
        <createTable schemaName="str" tableName="rb">
            <column name="rb" type="VARCHAR(18)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_zahtjeva" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_rb_zahtjev"
                             references="str.zahtjev(id_zahtjeva)"/>
            </column>
            <column name="id_sso" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_rb_sso"
                             references="str.sso(id_sso)"/>
            </column>
            <column name="status" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="datum_izd" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="datum_od" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="datum_do" type="DATE"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE str.rb
                ADD CONSTRAINT chk_rb_format
                    CHECK (rb ~ '^HR[0-9]{8}$'),
                ADD CONSTRAINT chk_rb_status
                    CHECK (status IN ('U_OBRADI', 'AKTIVAN', 'SUSPENDIRAN', 'POVUCEN'))
        </sql>

        <createIndex schemaName="str" tableName="rb" indexName="idx_rb_sso">
            <column name="id_sso"/>
        </createIndex>
        <createIndex schemaName="str" tableName="rb" indexName="idx_rb_status">
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropTable schemaName="str" tableName="rb"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
