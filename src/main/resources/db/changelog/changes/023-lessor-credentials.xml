<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
        STR-ERA SHEMA V2 — STR IZNAJMLJIVAČ:
          * Korisničko_ime
          * Lozinka korisnika
        Koristi se za login non-EU iznajmljivača (EU ide kroz eIDAS).
    -->
    <changeSet id="023-lessor-credentials" author="str-backend">
        <addColumn schemaName="str_rn" tableName="lessor">
            <column name="username" type="VARCHAR(64)"
                    remarks="Korisničko ime za login non-EU iznajmljivača (null za EU iznajmljivače koji idu kroz eIDAS)"/>
            <column name="password_hash" type="VARCHAR(255)"
                    remarks="BCrypt hash lozinke; null za EU iznajmljivače"/>
        </addColumn>

        <addUniqueConstraint schemaName="str_rn" tableName="lessor"
                             columnNames="username"
                             constraintName="uk_lessor_username"/>

        <rollback>
            <dropUniqueConstraint schemaName="str_rn" tableName="lessor"
                                  constraintName="uk_lessor_username"/>
            <dropColumn schemaName="str_rn" tableName="lessor" columnName="password_hash"/>
            <dropColumn schemaName="str_rn" tableName="lessor" columnName="username"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
