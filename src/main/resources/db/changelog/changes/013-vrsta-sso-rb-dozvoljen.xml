<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- STR spec §2.1: Hotel and Kamp must not receive RB. Flag on vrsta_sso gates RB issuance. -->
    <changeSet id="013-add-vrsta-sso-rb-dozvoljen" author="str-backend">
        <addColumn schemaName="str" tableName="vrsta_sso">
            <column name="rb_dozvoljen" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn schemaName="str" tableName="vrsta_sso" columnName="rb_dozvoljen"/>
        </rollback>
    </changeSet>

    <changeSet id="013-seed-vrsta-sso-hotel-kamp" author="str-backend">
        <insert schemaName="str" tableName="vrsta_sso">
            <column name="naziv" value="Hotel"/>
            <column name="rb_dozvoljen" valueBoolean="false"/>
        </insert>
        <insert schemaName="str" tableName="vrsta_sso">
            <column name="naziv" value="Kamp"/>
            <column name="rb_dozvoljen" valueBoolean="false"/>
        </insert>
        <rollback>
            <delete schemaName="str" tableName="vrsta_sso">
                <where>naziv IN ('Hotel', 'Kamp')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
