<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      Mock tablica koje popis objekata za NIAS dashboard joina, a lokalno ih nema
      (context="local"; na dev/prod ih posjeduje eTurizam i read-only su).

      Struktura je prepisana iz definicije view-a str.vw_src_facility_actual na dev-u:
        facility_type      → codebook_element (type_id, sub_type_id)  = vrsta / podvrsta
        facility.category_id / business_status_id → codebook_element  = kategorija / status
        facility.address_id → address, pa imena preko settlement/street/house_number/
                              municipality/county (denormalizirane kolone u address su
                              na dev-u gotovo prazne, pa je hijerarhija primarna)
        facility_capacity  → codebook_element (CAT_BROJ_KREVETA)      = broj kreveta
        facility_unit(+_capacity)                                     = jedinice hotela i sl.

      INTENTIONALLY LOOSE SCHEMA, kao i 100-str-schema-local: bez FK-ova i NOT NULL-ova.
    -->

    <changeSet id="123-str-codebook-element" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="codebook_element"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="codebook_element">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="code" type="VARCHAR(100)"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="codebook_id" type="BIGINT"/>
        </createTable>
        <createIndex schemaName="str" tableName="codebook_element" indexName="idx_str_codebook_element_code">
            <column name="code"/>
        </createIndex>
    </changeSet>

    <changeSet id="123-str-document" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="document"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="document">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="business_case_id" type="BIGINT"/>
            <column name="subject_version_id" type="BIGINT"/>
            <column name="registry_number" type="VARCHAR(64)"/>
            <column name="subtype_code" type="VARCHAR(64)"/>
            <column name="issue_date" type="DATE"/>
        </createTable>
        <createIndex schemaName="str" tableName="document" indexName="idx_str_document_business_case">
            <column name="business_case_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="123-str-facility-type" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="facility_type"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="facility_type">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="facility_id" type="BIGINT"/>
            <column name="type_id" type="BIGINT"/>
            <column name="sub_type_id" type="BIGINT"/>
        </createTable>
        <createIndex schemaName="str" tableName="facility_type" indexName="idx_str_facility_type_facility">
            <column name="facility_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="123-str-facility-capacity" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="facility_capacity"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="facility_capacity">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="facility_id" type="BIGINT"/>
            <column name="type_id" type="BIGINT"/>
            <column name="quantity" type="INTEGER"/>
        </createTable>
        <createIndex schemaName="str" tableName="facility_capacity" indexName="idx_str_facility_capacity_facility">
            <column name="facility_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="123-str-facility-unit" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="facility_unit"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="facility_unit">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="facility_id" type="BIGINT"/>
            <column name="type_id" type="BIGINT"/>
            <column name="number_of_units" type="INTEGER"/>
            <column name="registration_number" type="VARCHAR(64)"/>
        </createTable>
        <createIndex schemaName="str" tableName="facility_unit" indexName="idx_str_facility_unit_facility">
            <column name="facility_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="123-str-facility-unit-capacity" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="facility_unit_capacity"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="facility_unit_capacity">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="facility_unit_id" type="BIGINT"/>
            <column name="type_id" type="BIGINT"/>
            <column name="quantity" type="INTEGER"/>
        </createTable>
        <createIndex schemaName="str" tableName="facility_unit_capacity" indexName="idx_str_facility_unit_capacity_unit">
            <column name="facility_unit_id"/>
