    </changeSet>

    <changeSet id="123-str-address" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="address"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="address">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="country_id" type="BIGINT"/>
            <column name="county_id" type="BIGINT"/>
            <column name="municipality_id" type="BIGINT"/>
            <column name="settlement_id" type="BIGINT"/>
            <column name="street_id" type="BIGINT"/>
            <column name="house_number_id" type="BIGINT"/>
            <column name="county" type="VARCHAR(255)"/>
            <column name="municipality" type="VARCHAR(255)"/>
            <column name="settlement" type="VARCHAR(255)"/>
            <column name="street" type="VARCHAR(255)"/>
            <column name="house_number" type="VARCHAR(32)"/>
            <column name="postal_code" type="VARCHAR(16)"/>
            <column name="full_address" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="123-str-address-hierarchy" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="str" tableName="settlement"/></not>
        </preConditions>
        <createTable schemaName="str" tableName="county">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="country_id" type="BIGINT"/>
        </createTable>
        <createTable schemaName="str" tableName="municipality">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="county_id" type="BIGINT"/>
        </createTable>
        <createTable schemaName="str" tableName="settlement">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="municipality_id" type="BIGINT"/>
            <column name="postal_code" type="VARCHAR(16)"/>
        </createTable>
        <createTable schemaName="str" tableName="street">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="settlement_id" type="BIGINT"/>
        </createTable>
        <createTable schemaName="str" tableName="house_number">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(32)"/>
            <column name="street_id" type="BIGINT"/>
        </createTable>
    </changeSet>

