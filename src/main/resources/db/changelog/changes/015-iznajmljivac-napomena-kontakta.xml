<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- STR funkcionalna specifikacija §6.2 A: "Napomena kontakta" as part of kontakt podaci. -->
    <changeSet id="015-iznajmljivac-add-napomena-kontakta" author="str-backend">
        <addColumn schemaName="str" tableName="iznajmljivac">
            <column name="napomena_kontakta" type="VARCHAR(1024)"/>
            <column name="adresa_zastupnika" type="VARCHAR(255)"/>
        </addColumn>
        <rollback>
            <dropColumn schemaName="str" tableName="iznajmljivac" columnName="napomena_kontakta"/>
            <dropColumn schemaName="str" tableName="iznajmljivac" columnName="adresa_zastupnika"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
