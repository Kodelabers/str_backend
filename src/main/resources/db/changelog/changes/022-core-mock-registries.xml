<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
        Mock vanjskih registara koji su u prod. ownani od core servisa: GIS (geokod/parcele),
        RPJ (registar prostornih jedinica), SR (sudski registar). Lokalni dev only — STR ih
        čita read-only kroz registries pakete.
    -->

    <changeSet id="022-create-core-gis-parcela" author="str-backend" context="local">
        <createTable schemaName="core" tableName="gis_parcela">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="katastarska_opcina" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="broj_cestice" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="povrsina_m2" type="INTEGER"/>
            <column name="namjena" type="VARCHAR(64)"/>
            <column name="legalan_objekt" type="BOOLEAN"/>
        </createTable>
        <createIndex schemaName="core" tableName="gis_parcela" indexName="idx_gis_parcela_ko_brc" unique="true">
            <column name="katastarska_opcina"/>
            <column name="broj_cestice"/>
        </createIndex>
        <rollback><dropTable schemaName="core" tableName="gis_parcela"/></rollback>
    </changeSet>

    <changeSet id="022-create-core-rpj-adresa" author="str-backend" context="local">
        <createTable schemaName="core" tableName="rpj_adresa">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="zupanija" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="grad" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="naselje" type="VARCHAR(128)"/>
            <column name="ulica" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="kucni_broj" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="postanski_broj" type="VARCHAR(8)"/>
        </createTable>
        <createIndex schemaName="core" tableName="rpj_adresa" indexName="idx_rpj_adresa_full">
            <column name="zupanija"/>
            <column name="grad"/>
            <column name="ulica"/>
            <column name="kucni_broj"/>
        </createIndex>
        <rollback><dropTable schemaName="core" tableName="rpj_adresa"/></rollback>
    </changeSet>

    <changeSet id="022-create-core-sr-pravna-osoba" author="str-backend" context="local">
        <createTable schemaName="core" tableName="sr_pravna_osoba">
            <column name="oib" type="VARCHAR(11)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="naziv" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sjediste" type="VARCHAR(255)"/>
            <column name="zastupnici" type="VARCHAR(1024)"/>
        </createTable>
        <rollback><dropTable schemaName="core" tableName="sr_pravna_osoba"/></rollback>
    </changeSet>

</databaseChangeLog>
