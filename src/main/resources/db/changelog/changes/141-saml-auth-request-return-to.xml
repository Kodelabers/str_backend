<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
      Put na FE-u kamo se korisnik vraća nakon NIAS prijave (?returnTo= na
      /saml2/authenticate/nias, NiasReturnTo). Uz request-store=database na ACS-u nema sesije, pa
      put putuje uz spremljeni AuthnRequest. NULL = fiksni nias.saml.success-redirect-url.
    -->
    <changeSet id="141-saml-auth-request-return-to" author="str-backend">
        <addColumn schemaName="str_rn" tableName="saml_auth_request">
            <column name="return_to" type="VARCHAR(2048)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
