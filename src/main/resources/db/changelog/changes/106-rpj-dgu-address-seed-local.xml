    <!--
      Seed for rpj_dgu address hierarchy. Picks 4 counties × a handful of
      municipalities × a handful of settlements to exercise the dropdown
      chain end-to-end:

        Grad Zagreb (21) → Zagreb (21024)         → Zagreb, Maksimir, Trešnjevka
        Splitsko-dalm. (17) → Split (17097)        → Split, Stobreč
                            → Trogir (17453)       → Trogir
        Istarska (18)     → Pula (18108)           → Pula
                            → Rovinj (18248)       → Rovinj
        Primorsko-gor. (8)→ Rijeka (08018)         → Rijeka
                            → Opatija (08043)      → Opatija

      Cross-schema FK conventions (must stay aligned with dev):
        - zupanije.zu_rb  = gradovi_i_opcine.zu_rb            (NUMERIC)
        - gradovi_i_opcine.jls_mb (5-char) = LPAD(naselja.jls_mb::text, 5, '0')
        - naselja.na_mb (6-char) = ar_ulice.naselje_id        (VARCHAR)

      Postal codes match by LOWER(naselje) = LOWER(na_ime), so naselje names
      here mirror na_ime exactly. INSPIRE-style numeric IDs use a stable offset.
    -->

    <changeSet id="106-rpj-dgu-seed-zupanije" author="str-backend" context="local">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM rpj_dgu.zupanije</sqlCheck>
        </preConditions>
        <insert schemaName="rpj_dgu" tableName="zupanije"><column name="id" valueNumeric="2195100008"/><column name="inspire_id" value="HR.DGU.RPJ:ZU.0000000008"/><column name="zu_ime" value="Primorsko-goranska županija"/><column name="zu_rb" valueNumeric="8"/></insert>
        <insert schemaName="rpj_dgu" tableName="zupanije"><column name="id" valueNumeric="2195100017"/><column name="inspire_id" value="HR.DGU.RPJ:ZU.0000000017"/><column name="zu_ime" value="Splitsko-dalmatinska županija"/><column name="zu_rb" valueNumeric="17"/></insert>
        <insert schemaName="rpj_dgu" tableName="zupanije"><column name="id" valueNumeric="2195100018"/><column name="inspire_id" value="HR.DGU.RPJ:ZU.0000000018"/><column name="zu_ime" value="Istarska županija"/><column name="zu_rb" valueNumeric="18"/></insert>
        <insert schemaName="rpj_dgu" tableName="zupanije"><column name="id" valueNumeric="2195100021"/><column name="inspire_id" value="HR.DGU.RPJ:ZU.0000000021"/><column name="zu_ime" value="Grad Zagreb"/><column name="zu_rb" valueNumeric="21"/></insert>
    </changeSet>

