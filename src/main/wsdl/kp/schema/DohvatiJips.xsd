<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
    targetNamespace="http://www.apis-it.hr/umu/2018/elements/FetchPins"
    xmlns:tns="http://www.apis-it.hr/umu/2018/elements/FetchPins">
    
    <!-- OPERATIONS -->
    
    <!-- DOHVATI JIPSOVE -->
    <xs:element name="DohvatiJipsoveRequest">
        <xs:complexType>
	        <xs:sequence>
	            <xs:element name="DohvatiJipsove" type="tns:DohvatiJipsoveType" />
	        </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="DohvatiJipsoveResponse">
        <xs:complexType>
	        <xs:sequence>
	            <xs:element name="DohvatiJipsoveOdgovor" type="tns:DohvatiJipsoveOdgovorType" />
	        </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- PROVJERI OIB -->
    <xs:element name="ProvjeriJipsRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ProvjeriJips" type="tns:ProvjeriJipsType" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="ProvjeriJipsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ProvjeriJipsOdgovor" type="tns:ProvjeriJipsOdgovorType" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <!-- ROOT element unutar zippanog xml file-a -->
    <xs:element name="JIPSes" type="tns:JipsesType" />
    
    <!-- END OF OPERATIONS -->

    <!-- COMPLEX TYPES -->
    
    <xs:complexType name="DohvatiJipsoveType">
        <xs:sequence>
            <xs:element name="SenderId" type="tns:SenderIdType" />
            <xs:element name="IdPosiljatelja" type="tns:IdPosiljateljaType" />
            <xs:element name="IdUpitaPosiljatelja" type="tns:GuidType" />
            <xs:element name="TsSlanja" type="tns:TimestampType" />
            <xs:element name="BrojStranice" type="tns:BrojType" />
        </xs:sequence>
    </xs:complexType>
    
    <xs:complexType name="DohvatiJipsoveOdgovorType">
        <xs:sequence>
            <xs:element name="SenderId" type="tns:SenderIdType" />
            <xs:element name="IdPosiljatelja" type="tns:IdPosiljateljaType" />
            <xs:element name="IdUpitaPosiljatelja" type="tns:GuidType" />
            <xs:element name="TsObrade" type="tns:TimestampType" />
            <xs:element name="ImaJosJipseva" type="tns:BooleanType" />
            <xs:choice>
            	<xs:element name="JipsesAsXmlZipBase64" type="xs:base64Binary"  />
            	<xs:element name="Pogreske" type="tns:PogreskeType" />
            </xs:choice>
        </xs:sequence>
    </xs:complexType>
    
	<!-- Element unutar JipsesAsXmlZipBase64 -->
	<xs:element name="Jipses">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Jips" type="JipsResponseType" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:complexType name="JipsResponseType">
		<xs:sequence>
			<xs:element name="IPS" type="IPSType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="IzvorRegistar" type="IzvorRegistarType" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	
    <xs:complexType name="ProvjeriJipsType">
        <xs:sequence>
            <xs:element name="SenderId" type="tns:SenderIdType" />
            <xs:element name="IdPosiljatelja" type="tns:IdPosiljateljaType" />
            <xs:element name="IdUpitaPosiljatelja" type="tns:GuidType" />
            <xs:element name="TsSlanja" type="tns:TimestampType" />
            <xs:element name="ListaJipsevaZaProvjeriti" type="tns:BoundJipsesType" />
        </xs:sequence>
    </xs:complexType>
    
    <xs:complexType name="ProvjeriJipsOdgovorType">
        <xs:sequence>
            <xs:element name="SenderId" type="tns:SenderIdType" />
            <xs:element name="IdPosiljatelja" type="tns:IdPosiljateljaType" />
            <xs:element name="IdUpitaPosiljatelja" type="tns:GuidType" />
            <xs:element name="TsObrade" type="tns:TimestampType" />
            <xs:choice>
            	<xs:element name="AktivniJipsovi" type="tns:BoundJipsesType" />
            	<xs:element name="Pogreske" type="tns:PogreskeType" />
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PogreskeType">
        <xs:sequence>
            <xs:element name="Pogreska" type="tns:PogreskaType" minOccurs="1" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>
    
    <xs:complexType name="PogreskaType">
        <xs:sequence>
            <xs:element name="IndikatorPogreske" type="tns:IndikatorPogreskeType" />
            <xs:element name="PorukaPogreske" type="tns:PorukaPogreskeType" />
            <xs:element name="GUID" type="tns:GuidType" />
            <xs:element name="VrijemePogreske" type="tns:TimestampType" />
        </xs:sequence>
    </xs:complexType>
    
    <xs:complexType name="JipsesType">
      <xs:sequence>
        <xs:element name="Jips" type="tns:JipsType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
  	</xs:complexType>
  	
  	 <xs:complexType name="BoundJipsesType">
      <xs:sequence>
        <xs:element name="Jips" type="tns:JipsType" minOccurs="0" maxOccurs="1000"/>
      </xs:sequence>
  	</xs:complexType>
  	
  	<xs:complexType name="JipsType">
       <xs:sequence>
       		<xs:element name="IPS" type="tns:IPSType" />
       		<xs:element name="IzvorRegistar" type="tns:IzvorRegistarType" />
       		<xs:element name="OibList" type="tns:OibListType" minOccurs="0" maxOccurs="1" /> 
       </xs:sequence>
    </xs:complexType>
    
    <xs:complexType name="OiboviSifraDrzaveType">
      <xs:sequence>
        <xs:element name="OibSifraDrzave" type="tns:OibSifraDrzaveType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
  	</xs:complexType>
  	
  	 
  	
  	<xs:complexType name="OibSifraDrzaveType">
		<xs:sequence>
			<xs:element name="Oib" type="tns:OibType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="SifraDrzave" type="tns:SifraDrzaveType" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="OibListType">
	  <xs:sequence>
	    <xs:element name="OibSifraDrzave" type="tns:OibSifraDrzaveType" minOccurs="0" maxOccurs="1000"/>
	  </xs:sequence>
	</xs:complexType>
    
    <!-- END OF COMPLEX TYPES -->
    
    <xs:simpleType name="IPSType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]*[a-z]*[a-zA-Z]*[0-9]*[a-zA-Z0-9]*" />
            <xs:minLength value="5"/>
      		<xs:maxLength value="30"/>
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="IzvorRegistarType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{3}" />
        </xs:restriction>
    </xs:simpleType>
    
    
    <!-- SIMPLE TYPES -->
    
    <xs:simpleType name="BrojType">
        <xs:restriction base="xs:int" />
    </xs:simpleType>
    
    <xs:simpleType name="PorukaPogreskeType">
        <xs:restriction base="xs:string" >
            <xs:maxLength value="300" />
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="GuidType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IndikatorPogreskeType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9A-Za-z]{1,4}" />
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="OibType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{11}" />
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="SifraDrzaveType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{2}" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="BooleanType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[T|F]" />
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="TimestampType">
        <xs:annotation><xs:documentation>Primjer formata: 01.02.2003 01:23:45.678</xs:documentation></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="(0[1-9]|[12][0-9]|3[01])\.(0[1-9]|1[012])\.(18|19|20)\d\d ([0-1][0-9]|[2][0-3]):([0-5][0-9]):([0-5][0-9])\.[0-9]{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="DatumVrijemeType">
        <xs:annotation><xs:documentation>Primjer formata: 01.02.2003 01:23:45</xs:documentation></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="(0[1-9]|[12][0-9]|3[01])\.(0[1-9]|1[012])\.(18|19|20)\d\d ([0-1][0-9]|[2][0-3]):([0-5][0-9]):([0-5][0-9])"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="DatumType">
        <xs:annotation><xs:documentation>Primjer formata: 01.02.2003</xs:documentation></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="(0[1-9]|[12][0-9]|3[01])\.(0[1-9]|1[012])\.(18|19|20)\d\d"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="SenderIdType">
        <xs:restriction base="xs:int">
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IdPosiljateljaType">
        <xs:restriction base="xs:int" />
    </xs:simpleType>
    <!-- END OF SIMPLE TYPES -->
    
</xs:schema>
