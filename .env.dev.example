# Copy to .env.dev NA KUTIJI (s-str-02.infodom.hr) i popuni tajne. NE commitati .env.dev.
# Used by: docker compose --env-file .env.dev up -d --build
#
# KAKO OVO DOLAZI DO APLIKACIJE
#   docker-compose.yml ima `env_file: - .env.dev`, pa SVE odavde ulazi u kontejner kao
#   environment varijabla. Novi ključ ne treba nigdje drugdje dodavati.
#
#   PRAZNA VRIJEDNOST NIJE ISTO ŠTO I NEPOSTAVLJENA. `KLJUC=` šalje praznu ali postavljenu
#   varijablu, a Spring default iz ${KLJUC:default} vrijedi samo kad varijabla NE POSTOJI.
#   Ključ koji ne postavljaš — zakomentiraj, ne ostavljaj prazan.
#
#   Datoteka MORA postojati: bez nje `docker compose up` puca na env_file.

# Draft encryption key (AES-256, 32 random bytes base64). Generiraj jednom i ne rotiraj —
# rotacija poništava postojeće šifrirane skice.
#   openssl rand -base64 32
DRAFT_ENC_KEY=

# =========================================================================================
# eGOP — uredsko poslovanje MINT-a (SOAP 1.2 + NTLM)
# =========================================================================================
# OVO JE JEDINA OKOLINA S KOJE JE eGOP DOHVATLJIV (interna InfoDom mreža). Na CDU ostaje
# ugašen. Prije paljenja provjeriti dohvatljivost — s HOSTA i IZ KONTEJNERA:
#   curl -sS -o /dev/null -w '%{http_code}\n' "http://egop2builder/EAI_MINT/ServiceMDM.asmx?wsdl"
#   docker exec str-backend getent hosts egop2builder
# Očekuj 401 (NTLM challenge) ili 200; vješanje = firewall. Prazan `getent` => treba
# `extra_hosts` u docker-compose.yml (vidi komentar tamo).
EGOP_ENABLED=true

# Adresa: jedna vrijednost, četiri endpointa se izvode iz nje. Bez ovoga aplikacija NE KRENE
# uz EGOP_ENABLED=true — namjerno, da se ne puca na tuđi eGOP zbog ugrađenog defaulta.
EGOP_BASE_URL=http://egop2builder/EAI_MINT

# NTLM (HTTP sloj) — InfoDomov dijeljeni test račun. TAJNA, ne u repo.
# Kod sam splitta DOMENA\korisnik i domenu predaje NTLM-u zasebno.
EGOP_USERNAME=INFODOM\student1
EGOP_PASSWORD=

# Aplikacijski identitet u SOAP payloadu (<egov:userName>INFODOM\strservis</egov:userName>).
# Potvrđeno valjanim za ovu okolinu; defaulti su isti, pa se obično ne moraju postavljati.
EGOP_APP_DOMAIN=INFODOM
EGOP_APP_USERNAME=strservis
# Rješavatelj predmeta — mora biti osoba s username-om. Prazno => app-domain\app-username.
# Ako OdrediRjesavatelja padne u logu (a KreirajPismeno2 zatim vrati nenadležnost), probati
# INFODOM\student1.
#EGOP_RJESAVATELJ=

# --- POSUDBENE ŠIFRE VRSTA ---------------------------------------------------------------
# STR-ove vrste još nisu unesene u eGOP šifrarnik, pa se za test prohodnosti koriste tuđe,
# semantički najbliže. Svako pismeno pamti pod kojom je šifrom poslano
# (egop_pismeno.egop_vrsta_sifra + .egop_vrsta_privremena) — to je popis za storniranje kad
# InfoDom dostavi prave šifre. Tada: zamijeniti vrijednosti ispod i EGOP_SIFRE_PRIVREMENE=false.
EGOP_SIFRE_PRIVREMENE=true
# Predmet: „Usluge u domaćinstvu" (naziv postoji i pod 8906 — zato eksplicitna šifra).
EGOP_SIFRA_PREDMETA=7765
EGOP_UPISNA_KNJIGA=NP
# Ustroj: MINISTARSTVO TURIZMA (korijen, oznaka 0000) iz DohvatiUstrojKorisnika.
EGOP_SIFRA_USTROJ=559
# Vrste subjekata: Pravna osoba 2, Fizička osoba 3.
EGOP_SIFRA_SUBJEKT_PRAVNA=2
EGOP_SIFRA_SUBJEKT_FIZICKA=3
# Vrste pismena. Zahtjev (100) i Prigovor (62) su prirodno ULAZNI, Obavijest (57) IZLAZNA —
# što se poklapa s našim 2 ulazna + 7 izlaznih akata. eGOP smjer izvodi iz vrste pismena, pa
# ovaj odabir ujedno drži smjerove ispravnima. Naziv na pismenu ostaje naš.
EGOP_SIFRA_PISMENA_ZAHTJEV=100
EGOP_SIFRA_PISMENA_PRIGOVOR=62
EGOP_SIFRA_PISMENA_FALLBACK=57

# Prazno: sve se urudžbira. Popis vrsta bez šifre više nije potreban jer fallback pokriva
# svaku vrstu; ostaje kao mehanizam za produkciju.
EGOP_AKTI_BEZ_SIFRE=

# --- DIJAGNOSTIKA ------------------------------------------------------------------------
# false: prolazni ispad eGOP-a ili jedan prazan šifrarnik ne smiju oboriti servis. Na ovoj
# okolini je već poznato da DohvatiUstrojActive vraća prazno (zato se ustroj čita s
# DohvatiUstrojKorisnika); ostali dohvati na startu tek se prvi put vide živi.
EGOP_CODEBOOKS_FAIL_FAST=false
# true => puni ispis naziv → šifra svih šifrarnika u log. Paliti kad se biraju šifre, pa
# gasiti: vrsta predmeta ima 2430.
EGOP_CODEBOOKS_LOG_CONTENTS=true
# DEBUG ispisuje svaki SOAP poziv s trajanjem. Za PRVI živi run — inače se iz loga vidi samo
# je li cijeli tok prošao, ne i koji je poziv visio ili pao.
EGOP_LOG_LEVEL=DEBUG
# true => pun SOAP envelope u logu. Samo za prvi test; ispisuje osobne podatke i base64 PDF,
# pa GASITI poslije.
EGOP_TRACE_SOAP=false
# Timeouti prema eGOP-u (default 5 s / 15 s). Dizati samo ako se pokaže da mreža traži više —
# urudžbiranje ide sinkrono na request threadu.
#EGOP_CONNECT_TIMEOUT_MS=5000
#EGOP_READ_TIMEOUT_MS=15000
