# Copy to .env.cdupreprod NA KUTIJI (172.20.8.143) i popuni tajne. NE commitati .env.cdupreprod.
# Used by: docker compose -f docker-compose.cdupreprod.yml --env-file .env.cdupreprod up -d --build
#
# KAKO OVO DOLAZI DO APLIKACIJE
#   docker-compose.cdupreprod.yml ima `env_file: - .env.cdupreprod`, pa SVE odavde ulazi u
#   kontejner kao environment varijabla. Novi ključ ne treba nigdje drugdje dodavati. Iznimka je
#   `environment:` blok u compose datoteci — on ima prednost i drži ono što je fiksno (profil,
#   CORS, URL-ovi, captcha). Jedini ključ koji compose čita i SAM (interpolacija, --env-file) je
#   EGOP_HOST_IP, za extra_hosts.
#
#   PRAZNA VRIJEDNOST NIJE ISTO ŠTO I NEPOSTAVLJENA. `KLJUC=` šalje praznu ali postavljenu
#   varijablu, a Spring default iz ${KLJUC:default} vrijedi samo kad varijabla NE POSTOJI.
#   Ključ koji ne postavljaš — zakomentiraj, ne ostavljaj prazan. Iznimka su ključevi čiji je
#   default ionako prazan (STR_TIJELO_OIB, STR_TIJELO_PROPIS, STR_POTPISNIK_IME).
#
#   Datoteka MORA postojati: bez nje `docker compose up` puca na env_file.

# =========================================================================================
# BAZA — 172.20.8.212:5432/eturizam, RESETIRA SE SVAKE NOĆI
# =========================================================================================
# POZOR: shema i rola su pretpostavka (str_rn / str_owner, kao na CDU testu). Uputa je stigla s
# `currentSchema=xxx` i `role=xxx_owner` — kad DBA potvrdi imena, ispravi ovaj redak.
#
# `options=-c%20role%3D<rola>` radi SET ROLE na svakoj konekciji — objekti u našoj shemi su u
# vlasništvu te role. Mora ostati URL-encodirano (%20 = razmak, %3D = '='). Ako user nije član
# role, konekcija pada već na handshakeu. Provjera s laptopa (VPN gore):
#   psql "postgresql://<user>@172.20.8.212:5432/eturizam?options=-c%20role%3Dstr_owner" -c "select current_user, session_user"
CDUPREPROD_DB_URL=jdbc:postgresql://172.20.8.212:5432/eturizam?currentSchema=str_rn&options=-c%20role%3Dstr_owner
# Aplikacijski (ne osobni!) user. Lozinka je „ista kao na str2 testu i na pretprodukciji u
# Infodomu" — potvrditi s Darkom Bosnarom / Simonom.
CDUPREPROD_DB_USERNAME=
CDUPREPROD_DB_PASSWORD=

# =========================================================================================
# TAJNE
# =========================================================================================
# Draft encryption key (AES-256, 32 random bajta base64). Generiraj JEDNOM i ne rotiraj —
# rotacija poništava sve postojeće skice.
#   openssl rand -base64 32
DRAFT_ENC_KEY=

# ALTCHA HMAC ključ za captchu na 4 javna formulara. TAJNA, i OBAVEZNA: captcha je ovdje
# UKLJUČENA (okolina je na HTTPS-u pa Web Crypto radi). AltchaService u konstruktoru odbija i
# prazan ključ i ugrađeni `change-me-in-production`, pa backend bez ovoga NE STARTA — s jasnom
# porukom u logu, što je namjerno bolje od tihog 500 na /api/captcha/challenge.
# Generiraj jednom, ne rotiraj — restart s novim ključem obara sve izazove u tijeku.
#   openssl rand -base64 32
CAPTCHA_HMAC_KEY=

# =========================================================================================
# NIAS — PRODUKCIJSKI (https://nias.gov.hr/metadata)
# =========================================================================================
# Prije paljenja provjeri dohvatljivost S KUTIJE — metadata se čita pri dizanju konteksta, pa
# nedohvatljiv nias.gov.hr znači da aplikacija ne krene:
#   curl -sS -o /dev/null -w '%{http_code}\n' https://nias.gov.hr/metadata     # očekuj 200
# Ako je izlaz zatvoren, digni okolinu s NIAS_SAML_ENABLED=false (radi sve osim prijave) i traži
# otvaranje prema nias.gov.hr:443.
NIAS_SAML_ENABLED=true

# CERTIFIKAT: CN=e-Turizam (produkcijski FINA), po politici od 10/2026. Posuđeni „InterniTurizam"
# (~/str-rn/secrets/nias-prod.p12) se na ovoj okolini VIŠE NE KORISTI — ni mount ni datoteka.
#
# Datoteka nije naša i ne nosi se scp-om: stoji na kutiji u /opt/str/config-external, a
# docker-compose.cdupreprod.yml montira taj direktorij na istu putanju u kontejneru (read-only).
# Default putanja je u application-cdupreprod.properties: /opt/str/config-external/keystore.p12.
#
# NIAS_ENTITY_ID i NIAS_KEY_ALIAS čitaju se iz samog keystorea (lozinku upisuješ na upit, pa ne
# ostaje u historyju; keytool dolazi iz JRE imagea jer Jave na hostu nema):
#   docker run --rm -it -v /opt/str/config-external:/c:ro eclipse-temurin:21-jre-jammy \
#     keytool -list -v -storetype PKCS12 -keystore /c/keystore.p12
#   Alias name → NIAS_KEY_ALIAS
#   Owner      → NIAS_ENTITY_ID   (cijeli DN, TOČNO kako je ispisan)
#   Issuer     → mora biti produkcijski FINA (Fina RDC 2020); demo CA ne radi s nias.gov.hr
#   Entry type → mora biti PrivateKeyEntry
# entity-id MORA biti Subject DN certifikata — NIAS ne čita SP metadatu, nego ima konfiguraciju
# vezanu uz certifikat, pa je DN identitet servisa. Razliku backend javlja na startu
# (WARN „NIAS entity-id se NE poklapa sa Subject DN-om"). Pogrešan alias obara start s popisom
# aliasa koji u keystoreu postoje.
#
# Uz certifikat su kod NIAS-a registrirani ACS i SLO za str-preprod-eturizam.gov.hr (defaulti
# niže), pa za razliku od InterniTurizma radi i ODJAVA.
NIAS_ENTITY_ID=
NIAS_KEY_ALIAS=
# TAJNA — lozinka e-Turizam keystorea. Živi SAMO ovdje (chmod 600), nigdje u repou.
# Pogrešna daje UnrecoverableKeyException / „keystore password was incorrect" na dizanju.
# Nakon promjene: `docker compose ... up -d`, NE `restart` — restart ne čita env_file ponovno.
NIAS_KEYSTORE_PASSWORD=
# NE postavljati dok se datoteka zove keystore.p12 — vrijedi default iz propertyja. Učitava se kao
# PKCS12, pa datoteka mora biti .p12/.pfx; .jks ne bi prošao.
# POZOR pri prelasku sa starog certifikata: stari redak NIAS_KEYSTORE_PATH=/secrets/nias-prod.p12
# MORA nestati iz .env-a — /secrets se više ne montira, pa bi backend pao na FileNotFoundException.
#NIAS_KEYSTORE_PATH=/opt/str/config-external/keystore.p12

# ACS/SLO/redirect URL-ovi rade na defaultima iz application-cdupreprod.properties
# (https://str-preprod-eturizam.gov.hr/...), a upravo su oni registrirani uz e-Turizam certifikat.
# Odkomentiraj samo ako se registracija promijeni — moraju se poklapati točno.
#NIAS_ACS_URL=
#NIAS_SLO_URL=
#NIAS_SUCCESS_REDIRECT_URL=
#NIAS_FAILURE_REDIRECT_URL=
#NIAS_LOGOUT_REDIRECT_URL=
#NIAS_METADATA_URI=
# `session` je default i ovdje je ispravan (HTTPS). `database` je bio nužan samo na InfoDom
# preprodu, koji je na plain HTTP-u.
#NIAS_REQUEST_STORE=session

# =========================================================================================
# eGOP — eGOP PREDPRODUKCIJA (egopeaieduc.mint.hr), od 22.10.2026.
# =========================================================================================
# Postupak paljenja, provjere iz kontejnera i povratak: DEPLOY-CDU-PREPROD.md §B5a.
# false => aktivan je EgopClientMock: KLASA/URBROJ se i dalje dodjeljuju, samo ne odlaze MINT-u.
# Povratak u slučaju problema je samo EGOP_ENABLED=false + `up -d` (bez rebuilda).
EGOP_ENABLED=true
# Bez sufiksa putanje — četiri servisa (ServiceMDM/Pismeno/Predmet/Subjekt.asmx) izvode se iz nje.
# Ime NEMA javni DNS (interni DNS kutije ga zna: CNAME egopeduc.mint.hr → 192.168.30.80);
# extra_hosts u docker-compose.cdupreprod.yml ga u kontejneru veže na EGOP_HOST_IP.
# Privremeno http (do prezentacije 23.10.2026.); cilj je https — https MORA ići preko imena, ne
# preko IP-a (certifikat). Prelazak je promjena ovog retka + `up -d`.
EGOP_BASE_URL=http://egopeaieduc.mint.hr
# IP eGOP predprodukcije (interni DNS kutije, provjereno 22.10.2026.: TCP 80/443 iz kontejnera
# prolazi, WSDL vraća 401 = NTLM). Compose ga čita jer se pokreće s --env-file.
# MORA biti postavljen: prazno => extra_hosts veže ime na 127.0.0.1 i to NADJAČA DNS.
EGOP_HOST_IP=192.168.30.80
# NTLM prijava prema eGOP-u — ISTI korisnik i lozinka kao na CDU testu (MINT, 22.10.2026.):
# prepisati iz .env.cdu na CDU test kutiji. S domenom piše se DOMENA\korisnik (env_file ne dira
# backslash).
EGOP_USERNAME=
EGOP_PASSWORD=
# Aplikacijski korisnik u SOAP payloadu (u čije ime se urudžbira) — strservis4, kao na testu.
# Bez domene => EGOP_APP_DOMAIN= ostaje PRAZAN, ali POSTAVLJEN — nepostavljen bi uzeo INFODOM.
EGOP_APP_DOMAIN=
EGOP_APP_USERNAME=strservis4
# Rješavatelj predmeta; prazno => aplikacijski korisnik.
EGOP_RJESAVATELJ=
# false: nedostupan eGOP ne smije oboriti start okoline. true samo za jednokratnu dijagnostiku.
EGOP_CODEBOOKS_FAIL_FAST=false
# true => ispis svih šifrarnika (naziv → šifra) na startu; za prvi start, pa false.
EGOP_CODEBOOKS_LOG_CONTENTS=false
# true => pun SOAP zahtjev/odgovor u logu (OIB, ime, base64 PDF). Samo za dijagnostiku, pa false.
EGOP_TRACE_SOAP=false
# Sve vrste pismena se urudžbiraju; šifre se razrješavaju po nazivu kroz MDM, pa EGOP_SIFRA_*
# ovdje NE postavljati (ID-evi se razlikuju po okolinama).
EGOP_AKTI_BEZ_SIFRE=
# Nadležna ustrojstvena jedinica predmeta (po nazivu). Default „MINISTARSTVO TURIZMA" strservis4 na
# eGOP testu NE VIDI (vidi samo stablo ispod uprave 649), pa urudžba pada na otvaranju predmeta.
# Na testu radi „Sektor za pravne poslove". Na predprodukciji provjeriti u CODEBOOK_USTROJ (B5a.3).
EGOP_NAZIV_USTROJ=Sektor za pravne poslove
# Pod čijim korisnikom idu akti nakon dodjele. Na eGOP testu službenik ne smije otvoriti predmet
# 334-06/11 („Odabranu ustrojstvenu jedinicu nije moguće postaviti kao nadležnu…", 22.10.2026.),
# pa svi akti idu pod strservis4. SLUZBENIK (urbroj službenika) tek kad MINT riješi prava.
EGOP_AKTI_KORISNIK=APLIKACIJSKI
# MINT-ove vrste pismena („Zahtjev za dodjelu registracijskog broja", „Obavijest o …") na eGOP
# testu NISU u DohvatiVrstePismenaActive za strservis4 (22.10.2026.). Dok ih nema, pismena idu pod
# općenitim „Zahtjev"/„Obavijest". Vrsta koja postoji pod MINT-ovim nazivom ima prednost pred
# fallbackom, pa ovo ne smeta kad MINT vrste unese — osim ZAHTJEV, koji tada treba maknuti.
# Fallback je skalar: višerječni ključevi (…_PISMENA_PRIJEDLOG_SUSPENZIJE) iz env-a se do popravka
# u EgopVrsteProperties ne vežu (CDU test, 22.10.2026.), pa ih ovdje ne koristiti.
STR_EGOP_VRSTE_NAZIVI_PISMENA_ZAHTJEV=Zahtjev
STR_EGOP_VRSTE_NAZIVI_PISMENAFALLBACK=Obavijest
# true => pismeno urudžbirano pod općenitom vrstom označi se u egop_pismeno.egop_vrsta_privremena.
EGOP_SIFRE_PRIVREMENE=true
# Prefiks lažne KLASE/URBROJ-a — vrijedi samo dok je EGOP_ENABLED=false (mock). PRAZAN jer
# naručitelj traži da na demo PDF-u izgledaju kao pravi. Ne prenositi na prod.
EGOP_MOCK_FILING_PREFIX=
# Otprema izlaznih pismena u korisnički pretinac (KP). Radi samo uz EGOP_ENABLED=true.
# POZOR: preprod je na produkcijskom NIAS-u i stvarnim OIB-ima — provjeriti s MINT-om kamo eGOP
# predprodukcija dostavlja (testni ili pravi pretinac). Vidi docs/eGOP-endpoint-analiza.md §KP.
EGOP_KP_ENABLED=true

# =========================================================================================
# IDENTITET TIJELA NA AKTIMA — čl. 98. st. 2 ZUP-a
# =========================================================================================
# Nekonfigurirano polje akt vidljivo ispisuje kao "[nije konfigurirano: ...]" i logira ERROR.
#
# OIB i propis o nadležnosti IMAJU default u application.properties (iz predloška akta koji je
# MINT poslao 11.09.2026.), pa ih ovdje NE postavljati praznima — prazna vrijednost je
# POSTAVLJENA vrijednost i pregazi default. Izmjereno na prvom deployu 18.09.: uz prazne
# vrijednosti startup javlja
#   startup_documents ... oib=PRAZAN (pregazio je default — provjeri .env)
# a akti izlaze bez OIB-a tijela, što je povreda čl. 98. st. 2 ZUP-a.
# Naziv se piše kako stoji u uvodu akta; zaglavlje i potpis ga sami pišu velikim slovima.
STR_TIJELO_NAZIV=Ministarstvo turizma i sporta
# STR_TIJELO_OIB=87892589782
STR_TIJELO_ADRESA=Prisavlje 14
STR_TIJELO_MJESTO=Zagreb
STR_TIJELO_USTROJ=Uprava za turizam
# Propis o nadležnosti: default je tekst iz predloška MINT-a; brojevi Narodnih novina još fale.
# STR_TIJELO_PROPIS=
STR_POTPISNIK_IME=
STR_POTPISNIK_FUNKCIJA=Voditelj postupka
# Paliti tek kad postoji kvalificirani elektronički pečat; do tada akt ne smije tvrditi ovjeru.
STR_EPECAT_ENABLED=false
STR_DOCUMENTS_RELOAD=false

# =========================================================================================
# E-POŠTA — UKLJUČENA, kao na CDU testu: stvarnim primateljima
# =========================================================================================
# Relay (servmail.ssc.gov.hr:25, bez autha i STARTTLS-a) i pošiljatelj (eturizam@mints.hr) su
# defaulti u application-cdupreprod.properties, pa se SPRING_MAIL_* i APP_MAIL_FROM ovdje NE
# postavljaju. Profil bez ovog retka drži poštu ugašenom (default false).
#
# Poruke idu STVARNIM primateljima: iznajmljivaču, na kontakt iz podneska (obavijest o izdanom
# RB-u, akti obustave/povlačenja, odobrenje/odbijanje non-EU registracije). str_rn se svake noći
# briše, pa su to samo adrese koje su testeri taj dan upisali. Startup log to javlja kao
#   startup_mail enabled=true host=servmail.ssc.gov.hr from=eturizam@mints.hr redirect_to=- — POZOR: poruke stvarno izlaze
# i to je ovdje OČEKIVANO.
# Provjera relaya s kutije prije paljenja: DEPLOY-CDU-PREPROD.md §B5. Ne prođe li — false.
APP_MAIL_ENABLED=true
# Preusmjeravanje SVIH poruka na jednu adresu (stvarni primatelj ide u predmet "[za: ...] ").
# Namjerno NIJE postavljeno — odluka 03.10.2026: kao na CDU testu, šalje se stvarnim primateljima.
# Prazan `APP_MAIL_REDIRECT_TO=` vrijedi isto kao nepostavljen.
#APP_MAIL_REDIRECT_TO=

# =========================================================================================
# BUILD STRATEGIJA (popunjava se nakon recona kutije — DEPLOY-CDU-PREPROD.md §C1)
# =========================================================================================
# Default je build-on-box (maven i vite u kontejneru). Ako kutija nema pristup Docker Hubu /
# maven repozitoriju, artefakti se buildaju lokalno i donose scp-om, a image ih samo COPY-a:
#BACKEND_DOCKERFILE=Dockerfile.artifact
#FRONTEND_DOCKERFILE=Dockerfile.artifact

# --- Zajednička sesija i OIB sustav (DEPLOY-CDU.md §8c) ---------------------------------------
# Defaulti su u application-<profil>.properties: sesije u session.spring_session (tablica
# str-internal-api), OIB sustav uključen za FO i PO. Povratak bez rebuilda:
#SPRING_SESSION_TABLE=str_rn.spring_session
#APP_OIB_REGISTRY_ENABLED=false
#APP_OIB_REGISTRY_LEGAL_ENTITY_ENABLED=false
#APP_OIB_REGISTRY_BASE_URL=
