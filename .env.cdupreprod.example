# Copy to .env.cdupreprod NA KUTIJI (172.20.8.143) i popuni tajne. NE commitati .env.cdupreprod.
# Used by: docker compose -f docker-compose.cdupreprod.yml --env-file .env.cdupreprod up -d --build
#
# KAKO OVO DOLAZI DO APLIKACIJE
#   docker-compose.cdupreprod.yml ima `env_file: - .env.cdupreprod`, pa SVE odavde ulazi u
#   kontejner kao environment varijabla. Novi ključ ne treba nigdje drugdje dodavati. Iznimka je
#   `environment:` blok u compose datoteci — on ima prednost i drži ono što je fiksno (profil,
#   CORS, URL-ovi, captcha, eGOP prekidač).
#
#   PRAZNA VRIJEDNOST NIJE ISTO ŠTO I NEPOSTAVLJENA. `KLJUC=` šalje praznu ali postavljenu
#   varijablu, a Spring default iz ${KLJUC:default} vrijedi samo kad varijabla NE POSTOJI.
#   Ključ koji ne postavljaš — zakomentiraj, ne ostavljaj prazan. Iznimka su ključevi čiji je
#   default ionako prazan (STR_TIJELO_OIB, STR_TIJELO_PROPIS, STR_POTPISNIK_IME).
#
#   Datoteka MORA postojati: bez nje `docker compose up` puca na env_file.

# =========================================================================================
# BAZA — 172.20.8.212:5432/eturizam, RESETIRA SE SVAKE NOĆI
# =========================================================================================
# POZOR: shema i rola su pretpostavka (str_rn / str_owner, kao na CDU testu). Uputa je stigla s
# `currentSchema=xxx` i `role=xxx_owner` — kad DBA potvrdi imena, ispravi ovaj redak.
#
# `options=-c%20role%3D<rola>` radi SET ROLE na svakoj konekciji — objekti u našoj shemi su u
# vlasništvu te role. Mora ostati URL-encodirano (%20 = razmak, %3D = '='). Ako user nije član
# role, konekcija pada već na handshakeu. Provjera s laptopa (VPN gore):
#   psql "postgresql://<user>@172.20.8.212:5432/eturizam?options=-c%20role%3Dstr_owner" -c "select current_user, session_user"
CDUPREPROD_DB_URL=jdbc:postgresql://172.20.8.212:5432/eturizam?currentSchema=str_rn&options=-c%20role%3Dstr_owner
# Aplikacijski (ne osobni!) user. Lozinka je „ista kao na str2 testu i na pretprodukciji u
# Infodomu" — potvrditi s Darkom Bosnarom / Simonom.
CDUPREPROD_DB_USERNAME=
CDUPREPROD_DB_PASSWORD=

# =========================================================================================
# TAJNE
# =========================================================================================
# Draft encryption key (AES-256, 32 random bajta base64). Generiraj JEDNOM i ne rotiraj —
# rotacija poništava sve postojeće skice.
#   openssl rand -base64 32
DRAFT_ENC_KEY=

# ALTCHA HMAC ključ za captchu na 4 javna formulara. TAJNA, i OBAVEZNA: captcha je ovdje
# UKLJUČENA (okolina je na HTTPS-u pa Web Crypto radi). AltchaService u konstruktoru odbija i
# prazan ključ i ugrađeni `change-me-in-production`, pa backend bez ovoga NE STARTA — s jasnom
# porukom u logu, što je namjerno bolje od tihog 500 na /api/captcha/challenge.
# Generiraj jednom, ne rotiraj — restart s novim ključem obara sve izazove u tijeku.
#   openssl rand -base64 32
CAPTCHA_HMAC_KEY=

# =========================================================================================
# NIAS — PRODUKCIJSKI (https://nias.gov.hr/metadata)
# =========================================================================================
# Prije paljenja provjeri dohvatljivost S KUTIJE — metadata se čita pri dizanju konteksta, pa
# nedohvatljiv nias.gov.hr znači da aplikacija ne krene:
#   curl -sS -o /dev/null -w '%{http_code}\n' https://nias.gov.hr/metadata     # očekuj 200
# Ako je izlaz zatvoren, digni okolinu s NIAS_SAML_ENABLED=false (radi sve osim prijave) i traži
# otvaranje prema nias.gov.hr:443.
NIAS_SAML_ENABLED=true

# Subject DN certifikata kojim se predstavljamo — NIAS ne čita SP metadatu, nego ima hardkodiranu
# konfiguraciju vezanu uz certifikat, pa je DN identitet servisa. Vrijednosti su iz produkcijskog
# keystorea (isti koji koristi InfoDom predprodukcija):
#   Alias      : interniturizam (fina rdc 2020)
#   Owner      : CN=InterniTurizam, L=ZAGREB, OID.2.5.4.97=HR87892589782, O=MINISTARSTVO TURIZMA I SPORTA, C=HR
#   Izdavatelj : CN=Fina RDC 2020  (PRODUKCIJSKI FINA CA)
#   Vrijedi do : 08.11.2026.
# Provjera u bilo kojem trenutku:
#   keytool -list -v -keystore nias-prod.p12 -storetype PKCS12 -storepass <lozinka>
#
# POZOR — OVO NIJE STR-ov VLASTITI CERTIFIKAT. Identitet je posuđeni „InterniTurizam". Posljedice:
#   - PRIJAVA bi trebala raditi: AuthnRequest nosi AssertionConsumerServiceURL i ide preko
#     preglednika, pa assertion sjedne na naš ACS.
#   - ODJAVA NE MOŽE raditi: NIAS logout callback šalje na URL registriran uz taj certifikat.
#     Ne trošiti vrijeme na debug — treba vlastiti FINA cert i registracija STR-a po okolini.
#   - ROK: 08.11.2026. Tražiti vlastiti certifikat prije toga.
NIAS_ENTITY_ID=CN=InterniTurizam, L=ZAGREB, OID.2.5.4.97=HR87892589782, O=MINISTARSTVO TURIZMA I SPORTA, C=HR
NIAS_KEY_ALIAS=interniturizam (fina rdc 2020)
# TAJNA — lozinka keystorea (Simon / FINA). Pogrešna daje UnrecoverableKeyException na dizanju.
NIAS_KEYSTORE_PASSWORD=
# Keystore se montira preko /secrets (CDUPREPROD_SECRETS_DIR). Učitava se kao PKCS12, pa datoteka
# mora biti .p12 — .jks ne bi prošao.
NIAS_KEYSTORE_PATH=/secrets/nias-prod.p12
# Default je `../secrets`, što se razrješava prema mjestu compose datoteke → ~/str-rn/secrets.
# Postavljati samo ako keystore stoji negdje drugdje.
#CDUPREPROD_SECRETS_DIR=../secrets

# ACS/SLO/redirect URL-ovi rade na defaultima iz application-cdupreprod.properties
# (https://str-preprod-eturizam.gov.hr/...). Odkomentiraj samo ako NIAS uz certifikat ima
# registrirane DRUGE URL-ove — moraju se poklapati točno.
#NIAS_ACS_URL=
#NIAS_SLO_URL=
#NIAS_SUCCESS_REDIRECT_URL=
#NIAS_FAILURE_REDIRECT_URL=
#NIAS_LOGOUT_REDIRECT_URL=
#NIAS_METADATA_URI=
# `session` je default i ovdje je ispravan (HTTPS). `database` je bio nužan samo na InfoDom
# preprodu, koji je na plain HTTP-u.
#NIAS_REQUEST_STORE=session

# =========================================================================================
# eGOP — UGAŠEN (odluka)
# =========================================================================================
# Prekidač je fiksiran u docker-compose.cdupreprod.yml; ovdje stoji radi vidljivosti.
# false => aktivan je EgopClientMock: KLASA/URBROJ se i dalje dodjeljuju (podnesak 1, obavijest 2
# po predmetu), samo ne odlaze prema MINT-u.
EGOP_ENABLED=false
# Prefiks lažne KLASE/URBROJ-a. Inače je "MOCK-" upravo zato da se izmišljeni brojevi razlikuju od
# pravih. Ovdje je PRAZAN jer naručitelj traži da na demo PDF-u izgledaju kao pravi.
# POSLJEDICA: oznake u submission.egop_klasa ne razlikuju se od pravih. Ne prenositi na prod.
EGOP_MOCK_FILING_PREFIX=

# =========================================================================================
# Popis dokumenata po registracijskom broju
# =========================================================================================
# false => korisniku se nakon izdavanja RB-a prikazuje samo Obavijest o dodjeli, bez podneska.
# Skriva SAMO popis: podnesak i dalje nosi ur. br. 1 i dohvatljiv je na /api/rn/{rn}/documents/zahtjev.
RN_DOCUMENTS_ZAHTJEV_VISIBLE=false

# =========================================================================================
# IDENTITET TIJELA NA AKTIMA — čl. 98. st. 2 ZUP-a
# =========================================================================================
# Dok su prazni, svaki akt vidljivo ispisuje "[nije konfigurirano: ...]" i logira ERROR.
# OIB NIJE potvrđen: HR87892589782 iz DN-a pripada posuđenom certifikatu (InterniTurizam), pa
# ostaje prazan dok ga MINT ne potvrdi.
STR_TIJELO_NAZIV=MINISTARSTVO TURIZMA I SPORTA
STR_TIJELO_OIB=
STR_TIJELO_ADRESA=Prisavlje 14
STR_TIJELO_MJESTO=Zagreb
STR_TIJELO_USTROJ=Uprava za turizam
# Točan propis koji tijelu daje nadležnost za registracijski broj — potvrditi s pravnom službom.
STR_TIJELO_PROPIS=
STR_POTPISNIK_IME=
STR_POTPISNIK_FUNKCIJA=Voditelj postupka
# Paliti tek kad postoji kvalificirani elektronički pečat; do tada akt ne smije tvrditi ovjeru.
STR_EPECAT_ENABLED=false
STR_DOCUMENTS_RELOAD=false

# =========================================================================================
# E-POŠTA — UGAŠENA
# =========================================================================================
# Baza nosi podatke eTurizma (prave adrese i e-mailovi). S true bi okolina slala stvarne poruke
# stvarnim ljudima. S false radi LoggingEmailService (poruke samo u log). NE PALITI bez odluke.
APP_MAIL_ENABLED=false

# =========================================================================================
# BUILD STRATEGIJA (popunjava se nakon recona kutije — DEPLOY-CDU-PREPROD.md §C1)
# =========================================================================================
# Default je build-on-box (maven i vite u kontejneru). Ako kutija nema pristup Docker Hubu /
# maven repozitoriju, artefakti se buildaju lokalno i donose scp-om, a image ih samo COPY-a:
#BACKEND_DOCKERFILE=Dockerfile.artifact
#FRONTEND_DOCKERFILE=Dockerfile.artifact
