# Copy to .env.preprod NA KUTIJI (s-str-02.infodom.hr) i popuni tajne. NE commitati .env.preprod.
# Used by: docker compose -f docker-compose.preprod.yml --env-file .env.preprod up -d --build
#
# KAKO OVO DOLAZI DO APLIKACIJE
#   docker-compose.preprod.yml ima `env_file: - .env.preprod`, pa SVE odavde ulazi u kontejner
#   kao environment varijabla. Novi ključ ne treba nigdje drugdje dodavati. Iznimka je
#   `environment:` blok u compose datoteci — on ima prednost i drži ono što je fiksno
#   (profil, CORS, URL-ovi frontenda).
#
#   PRAZNA VRIJEDNOST NIJE ISTO ŠTO I NEPOSTAVLJENA. `KLJUC=` šalje praznu ali postavljenu
#   varijablu, a Spring default iz ${KLJUC:default} vrijedi samo kad varijabla NE POSTOJI.
#   Ključ koji ne postavljaš — zakomentiraj, ne ostavljaj prazan. Iznimka su ključevi čiji je
#   default ionako prazan (STR_TIJELO_OIB, STR_TIJELO_PROPIS, STR_POTPISNIK_IME).
#
#   Datoteka MORA postojati: bez nje `docker compose up` puca na env_file.

# =========================================================================================
# BAZA — produkcijski dump u bazi `eturizam` na s-str-02
# =========================================================================================
# Aplikacijski (ne osobni!) user; role su kopirane s CDU testa, pa se koriste CDU kredencijali.
# Lozinka je na CDU kutiji: ssh cdu; grep CDU_DB_PASSWORD ~/str-rn/str_backend/.env.cdu
#
# `options=-c%20role%3Dstr_owner` radi SET ROLE str_owner na svakoj konekciji — objekti u
# str_rn su u vlasništvu str_owner. Mora ostati URL-encodirano (%20 = razmak, %3D = '=').
# Ako user nije član role, konekcija pada već na handshakeu. Provjera:
#   psql "postgresql://<user>@s-str-02.infodom.hr:5431/eturizam" \
#        -c "select pg_has_role(current_user,'str_owner','member')"   # mora vratiti t
PREPROD_DB_URL=jdbc:postgresql://s-str-02.infodom.hr:5431/eturizam?currentSchema=str_rn&options=-c%20role%3Dstr_owner
PREPROD_DB_USERNAME=
PREPROD_DB_PASSWORD=

# =========================================================================================
# TAJNE
# =========================================================================================
# Draft encryption key (AES-256, 32 random bajta base64). Generiraj NOVU vrijednost za ovu
# okolinu — odluka 09.09.2026.: skice iz produkcijskog dumpa su na predprodukciji nebitne, pa
# se produkcijski ključ ovdje ne prenosi. Nove skice rade normalno; stare se ne mogu dešifrirati
# (dekripcija padne na tim zapisima, RB i ostalo nisu dirani).
# Generiraj jednom i ne rotiraj — rotacija poništava i skice nastale na ovoj okolini.
#   openssl rand -base64 32
DRAFT_ENC_KEY=

# ALTCHA HMAC ključ za captchu na 4 javna formulara. TAJNA — isti razred kao DRAFT_ENC_KEY.
# OBAVEZAN. Captcha je uključena na svim profilima osim `local`, a dva načina da se ovo zabrlja
# ponašaju se RAZLIČITO:
#   - ključ NEPOSTAVLJEN => vrijedi Spring default `change-me-in-production`, a AltchaService ga
#     u konstruktoru odbija => backend NE STARTA (jasna greška u logu).
#   - ključ PRAZAN (`CAPTCHA_HMAC_KEY=`) => prazna vrijednost je postavljena vrijednost i pregazi
#     Spring default, konstruktor je propusti, pa backend NORMALNO STARTA — a onda
#     GET /api/captcha/challenge vraća 500 (`Empty key` iz SecretKeySpec) i sva 4 javna formulara
#     su neupotrebljiva. Ovo je tiši i gadniji ishod od nepostavljenog ključa.
# Generiraj jednom, ne rotiraj — restart s novim ključem obara sve izazove u tijeku i korisnik
# na formularu dobije „provjera nije uspjela".
#   openssl rand -base64 32
CAPTCHA_HMAC_KEY=

# =========================================================================================
# NIAS — PRODUKCIJSKI (https://nias.gov.hr/metadata)
# =========================================================================================
# Prije paljenja provjeri dohvatljivost S KUTIJE — metadata se čita pri dizanju konteksta,
# pa nedohvatljiv nias.gov.hr znači da aplikacija ne krene:
#   curl -sS -o /dev/null -w '%{http_code}\n' https://nias.gov.hr/metadata     # očekuj 200
NIAS_SAML_ENABLED=true

# Subject DN certifikata kojim se predstavljamo — NIAS ne čita SP metadatu, nego ima
# hardkodiranu konfiguraciju vezanu uz certifikat, pa je DN identitet servisa.
# Vrijednosti ispod su iz keystorea dobivenog 09.09.2026. (jedini PrivateKeyEntry u njemu):
#   Alias      : interniturizam (fina rdc 2020)
#   Owner      : CN=InterniTurizam, L=ZAGREB, OID.2.5.4.97=HR87892589782, O=MINISTARSTVO TURIZMA I SPORTA, C=HR
#   Izdavatelj : CN=Fina RDC 2020  (PRODUKCIJSKI FINA CA — CDU-ov cert je s „Fina Demo CA 2020")
#   Vrijedi do : 08.11.2026.
# Provjera u bilo kojem trenutku:
#   keytool -list -v -keystore keystore.p12 -storetype PKCS12 -storepass <lozinka>
#
# POZOR — OVO JOŠ NIJE STR-ov VLASTITI CERTIFIKAT. Identitet je i dalje posuđeni
# „InterniTurizam"; nov je samo CA (produkcijski umjesto demo). Posljedice:
#   - PRIJAVA bi trebala raditi: AuthnRequest nosi AssertionConsumerServiceURL i ide preko
#     preglednika, pa assertion sjedne na naš ACS.
#   - ODJAVA NE MOŽE raditi: NIAS logout callback šalje na URL registriran uz taj certifikat,
#     tj. InterniTurizamu, ne nama. Ne trošiti vrijeme na debug — treba vlastiti FINA cert i
#     zasebna registracija STR-a na NIAS-u (InfoDom / MINTS).
#   - STR_TIJELO_OIB: HR87892589782 je OIB posuđenog identiteta, pa ostaje nepotvrđen.
#   - ROK: cert istječe 08.11.2026. Tražiti vlastiti prije toga.
NIAS_ENTITY_ID=CN=InterniTurizam, L=ZAGREB, OID.2.5.4.97=HR87892589782, O=MINISTARSTVO TURIZMA I SPORTA, C=HR
NIAS_KEY_ALIAS=interniturizam (fina rdc 2020)
# TAJNA — ne upisivati u repo, samo u .env.preprod na kutiji.
NIAS_KEYSTORE_PASSWORD=
# Keystore se montira preko /secrets (PREPROD_SECRETS_DIR, default /home/vviskov/str-secrets).
# Učitava se kao PKCS12, pa datoteka mora biti .p12 — .jks ne bi prošao.
NIAS_KEYSTORE_PATH=/secrets/nias-prod.p12

# Gdje se čuva odlazni AuthnRequest: `database` (ovdje) ili `session` (Springov default).
# Preko plain HTTP-a `session` NE RADI — NIAS na ACS šalje cross-site POST, na kojem preglednik
# ne šalje SameSite=Lax cookie, a SameSite=None traži Secure koji bez HTTPS-a otpada; prijava
# tada pada s `invalid_in_response_to`. Vrijednost je već postavljena u profilu, ovdje se dira
# samo ako okolina dobije HTTPS pa se želi vratiti na sesiju.
#NIAS_REQUEST_STORE=database
#PREPROD_SECRETS_DIR=/home/vviskov/str-secrets

# ACS/SLO/redirect URL-ovi rade na defaultima iz application-preprod.properties
# (http://s-str-02.infodom.hr:8086/... za SAML endpointe, :8085 za frontend). Odkomentiraj samo
# ako NIAS uz novi certifikat ima registrirane DRUGE URL-ove — moraju se poklapati točno.
#NIAS_ACS_URL=
#NIAS_SLO_URL=
#NIAS_SUCCESS_REDIRECT_URL=
#NIAS_FAILURE_REDIRECT_URL=
#NIAS_LOGOUT_REDIRECT_URL=
#NIAS_METADATA_URI=

# =========================================================================================
# eGOP — UGAŠEN na predprodukciji
# =========================================================================================
# Predprodukcija ne smije dirati uredsko poslovanje. false => EgopConfig, EgopClientImpl,
# EgopCodebooks i EgopRetryJob se uopće ne instanciraju (@ConditionalOnProperty havingValue=true),
# pa nema ni SOAP poziva ni cron poslova prema eGOP-u; aktivan je EgopClientMock.
#
# NAPOMENA: to ne znači da se ništa ne urudžbira. RnIssuedListener i RnLifecycleFilingListener
# nisu vezani na ovaj prekidač, pa tok prolazi kroz mock koji upisuje `MOCK-` prefiksiranu
# KLASU/URBROJ u submission.egop_klasa / filing_number i redove u str_rn.egop_pismeno.
# Prefiks postoji upravo da se lažni brojevi razlikuju od pravih.
EGOP_ENABLED=false

# =========================================================================================
# IDENTITET TIJELA NA AKTIMA — čl. 98. st. 2 ZUP-a
# =========================================================================================
# Dok su prazni, svaki akt vidljivo ispisuje "[nije konfigurirano: ...]" i logira ERROR.
# OIB NIJE potvrđen: HR87892589782 iz CDU konfiguracije pripada posuđenom certifikatu
# (InterniTurizam) — s produkcijskim certifikatom ga treba pročitati iz njegovog DN-a i
# potvrditi s MINT-om prije nego akti odu strankama.
STR_TIJELO_NAZIV=MINISTARSTVO TURIZMA I SPORTA
STR_TIJELO_OIB=
STR_TIJELO_ADRESA=Prisavlje 14
STR_TIJELO_MJESTO=Zagreb
STR_TIJELO_USTROJ=Uprava za turizam
# Točan propis koji tijelu daje nadležnost za registracijski broj — potvrditi s pravnom službom.
STR_TIJELO_PROPIS=
STR_POTPISNIK_IME=
STR_POTPISNIK_FUNKCIJA=Voditelj postupka
# Paliti tek kad postoji kvalificirani elektronički pečat; do tada akt ne smije tvrditi ovjeru.
STR_EPECAT_ENABLED=false
STR_DOCUMENTS_RELOAD=false

# =========================================================================================
# E-POŠTA — UGAŠENA
# =========================================================================================
# U dumpu su PRAVE adrese iznajmljivača, a S-SMTP-01.infodom.hr je s ove kutije dohvatljiv i
# ne traži autentikaciju. S true bi predprodukcija slala stvarne mailove stvarnim ljudima.
# NE PALITI bez izričite odluke. S false radi LoggingEmailService (poruke samo u log).
APP_MAIL_ENABLED=false
